{\rtf1\ansi\ansicpg1251\uc1 \deff0\deflang1033\deflangfe1033{\fonttbl{\f0\froman\fcharset0\fprq2{\*\panose 02020603050405020304}Times New Roman;}{\f1\fswiss\fcharset0\fprq2{\*\panose 020b0604020202020204}Arial;}{\f3\froman\fcharset2\fprq2{\*\panose 05050102010706020507}Symbol;}{\f5\fswiss\fcharset0\fprq2{\*\panose 020b0604020202020204}HELVETICA;}{\f10\froman\fcharset0\fprq2{\*\panose 00000000000000000000}MS Serif{\*\falt Times New Roman};}{\f16\fswiss\fcharset204\fprq2{\*\panose 020b0604020202020204}ARIAL CYR;}{\f17\froman\fcharset204\fprq2{\*\panose 02020603050405020304}TIMES NEW ROMAN CYR;}{\f193\froman\fcharset238\fprq2 Times New Roman CE;}{\f194\froman\fcharset204\fprq2 Times New Roman Cyr;}{\f196\froman\fcharset161\fprq2 Times New Roman Greek;}{\f197\froman\fcharset162\fprq2 Times New Roman Tur;}{\f198\froman\fcharset186\fprq2 Times New Roman Baltic;}{\f199\fswiss\fcharset238\fprq2 Arial CE;}{\f200\fswiss\fcharset204\fprq2 Arial Cyr;}{\f202\fswiss\fcharset161\fprq2 Arial Greek;}{\f203\fswiss\fcharset162\fprq2 Arial Tur;}{\f204\fswiss\fcharset186\fprq2 Arial Baltic;}{\f223\fswiss\fcharset238\fprq2 HELVETICA CE;}{\f224\fswiss\fcharset204\fprq2 HELVETICA Cyr;}{\f226\fswiss\fcharset161\fprq2 HELVETICA Greek;}{\f227\fswiss\fcharset162\fprq2 HELVETICA Tur;}{\f228\fswiss\fcharset186\fprq2 HELVETICA Baltic;}{\f291\fswiss\fcharset0\fprq2 ARIAL CYR;}{\f289\fswiss\fcharset238\fprq2 ARIAL CYR CE;}{\f292\fswiss\fcharset161\fprq2 ARIAL CYR Greek;}{\f293\fswiss\fcharset162\fprq2 ARIAL CYR Tur;}{\f294\fswiss\fcharset186\fprq2 ARIAL CYR Baltic;}{\f297\froman\fcharset0\fprq2 TIMES NEW ROMAN CYR;}{\f295\froman\fcharset238\fprq2 TIMES NEW ROMAN CYR CE;}{\f298\froman\fcharset161\fprq2 TIMES NEW ROMAN CYR Greek;}{\f299\froman\fcharset162\fprq2 TIMES NEW ROMAN CYR Tur;}{\f300\froman\fcharset186\fprq2 TIMES NEW ROMAN CYR Baltic;}}{\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;\red255\green0\blue255;\red255\green0\blue0;\red255\green255\blue0;\red255\green255\blue255;\red0\green0\blue128;\red0\green128\blue128;\red0\green128\blue0;\red128\green0\blue128;\red128\green0\blue0;\red128\green128\blue0;\red128\green128\blue128;\red192\green192\blue192;}{\stylesheet{\qj\sb120\nowidctlpar\adjustright \lang2057\cgrid \snext0 Normal;}{\s1\qj\sb240\sa60\keepn\nowidctlpar\adjustright \b\f1\fs28\lang2057\kerning28\cgrid \sbasedon0 \snext0 heading 1;}{\s2\qj\sb240\sa60\keepn\nowidctlpar\adjustright \b\i\f1\lang2057\cgrid \sbasedon0 \snext0 heading 2;}{\s3\qj\sb320\sa320\sl240\slmult0\keepn\nowidctlpar\hyphpar0\adjustright \b\fs26\lang2057\kerning20\cgrid \sbasedon0 \snext0 heading 3;}{\*\cs10 \additive Default Paragraph Font;}{\s15\sb120\sa120\nowidctlpar\adjustright \i\lang2057\cgrid \sbasedon0 \snext0 Table;}{\s16\fi-283\li283\sb240\nowidctlpar{\*\pn \pnlvlbody\ilvl11\ls2047\pnrnot0\pnf5\pnstart1\pnindent283\pnhang{\pntxtb \'b7}}\ls2047\ilvl11\adjustright \b\f1\fs44\lang2057\cgrid \sbasedon0 \snext17 Bulleted list;}{\s17\fi-283\li568\sb60\nowidctlpar{\*\pn \pnlvlbody\ilvl11\ls2047\pnrnot0\pnf5\pnstart1\pnindent283\pnhang{\pntxtb *}}\ls2047\ilvl11\adjustright \b\f1\fs44\lang2057\cgrid \sbasedon16 \snext17 indented bulleted;}{\s18\qj\sb120\nowidctlpar\adjustright \i\lang2057\cgrid \sbasedon0 \snext0 caption;}{\s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid \sbasedon0 \snext19 footnote text;}{\*\cs20 \additive \fs20\super \sbasedon10 footnote reference;}{\s21\qj\sl240\slmult0\nowidctlpar\adjustright \fs26\lang2057\kerning20\cgrid \sbasedon0 \snext0 Runon;}{\*\cs22 \additive \fs16 \sbasedon10 annotation reference;}{\s23\sb60\sl240\slmult0\nowidctlpar\adjustright \fs26\lang2057\kerning20\cgrid \sbasedon0 \snext23 Tabletext;}{\s24\qj\sb120\nowidctlpar\adjustright \fs20\lang2057\cgrid \sbasedon0 \snext24 annotation text;}{\s25\qj\li238\sb120\sa120\sl-260\slmult0\nowidctlpar\adjustright \fs22\lang2057\kerning20\cgrid \sbasedon0 \snext25 Quote;}{\s26\qj\fi-709\li709\sb60\sa120\sl240\slmult0\nowidctlpar\adjustright \i\fs22\lang2057\kerning20\cgrid \sbasedon0 \snext26 source;}{\s27\qj\fi-720\li720\sb120\sl240\slmult0\nowidctlpar\adjustright \fs26\lang2057\kerning20\cgrid \sbasedon0 \snext27 Body Text 2;}}{\info{\title The Economics and Sociology of Wage Differentiation: the Russian case}{\author Simon Clarke}{\operator Simon Clarke}{\creatim\yr2000\mo7\dy21\hr11\min40}{\revtim\yr2000\mo7\dy21\hr15\min37}{\printim\yr1999\mo12\dy22\hr23\min19}{\version3}{\edmins0}{\nofpages29}{\nofwords11435}{\nofchars65184}{\*\company Department of Sociology}{\nofcharsws80050}{\vern71}}\paperw11907\paperh16840\margl1797\margr1797 \widowctrl\ftnbj\aenddoc\lytprtmet\hyphcaps0\formshade\viewkind1\viewscale117\viewzk2\pgbrdrhead\pgbrdrfoot \fet0{\*\docvar {EN_Doc_Font_List_Name}{Times New RomanTimes New Roman Cyr}}{\*\docvar {EN_Lib_Name_List_Name}{11odarefs.enl}}{\*\docvar {EN_Main_Body_Style_Name}{Sociology.ens}}\sectd \linex0\headery709\footery709\colsx709\sectdefaultcl {\*\pnseclvl1\pnucrm\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl2\pnucltr\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl3\pndec\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl4\pnlcltr\pnstart1\pnindent720\pnhang{\pntxta )}}{\*\pnseclvl5\pndec\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl6\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl7\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl8\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl9\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}\pard\plain \s1\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\f1\fs28\lang2057\kerning28\cgrid {\f16 The Economics and Sociology of Wage Differentiation: the Russian case
\par }\pard\plain \sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {\i\f17 Simon Clarke\line Centre for Comparative Labour Studies,\line University of Warwick \line }{\f17 and \line }{\i\f17 Institute for Comparative Labour Relations Research (ISITO), Moscow.
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {Version 21 July 2000
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {The transition to a market economy was expected by economists to lead to an increase in wage inequality as wages were freed from administrative control and wage differentials increased in order to stimulate the flow of labour from less to more productive employments in accordance with changing economic conditions. The greater the degree of economic restructuring, the greater the mobility of labour that would be implied and so the greater the degree of wage inequality that might be required to encourage this mobility. During the period of disequilibrium we would expect firm-specific factors to prevail in the determination of wage differentials, as more prosperous employers were willing and able to pay higher wages to attract employees from less prosperous employers. As people moved from low- to high-wage jobs, competitive labour market theory would lead us to expect the labour market to move back towards an equilibrium in which pay differentials would be reduced and would reflect differences in the skill and experience of employees. In the Russian case it is almost ten years since the abolition of the administrative control of wages, during which time almost a quarter of the labour force has changed jobs each year. In this paper I want to analyse the available data to ask whether wages have behaved in the way that would be predicted by competitive labour market theory and to suggest that a sociological (or institutionalist) approach to wage differentiation is more fruitful.
\par }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {The Economics and Sociology of Wage Differentiation}{\f17  
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {\f17 Economists and sociologists tend to take very different approaches to the explanation of wage differentiation. Economists emphasise the role of wages in clearing the labour market, while sociologists emphasise the role of wages as a motivating factor in the social organisation of the labour process. For the economist, pay differentials in equilibrium should correspond to differences in the \lquote human capital\rquote  of individuals and corresponding differences in their productivity. For the sociologist, pay differentials are more likely to be embedded in the social organisation of the workplace and locality and the employment strategies of particular employers.}{\cs20\f17\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb240\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ The different emphases of economists and sociologists of labour reproduce aspects of the earlier debates between neoclassical and institutionalist economists that were to some extent synthesised in the post-war discipline of \lquote industrial relations\rquote , within which labour economists such as Clark Kerr and John Dunlop focused particularly on the institutional and economic framework within which wage differentials were determined. Institutionalism remains alive in the work of economists such as Les Thurow, who recently noted that \lquote one of the ways to explain unequal wages for equal workers is to see wages as being attached to the job\rquote  ( Thurow, 1998, p. 32).\-}}}{ For the competitive labour market economist the individual can increase his or her pay by undertaking appropriate education and training, conceptualised as an \lquote investment\rquote  in his or her \lquote human capital\rquote . For the sociologist the individual can increase his or her pay by getting a better job, a process which often depends on mobilising the individual\rquote s connections (accommodated in the economists\rquote  model by transforming friendship and kinship into \lquote social capital\rquote ).}{\f17 
\par In the real world, wages play a dual role in the capitalist economy so that both of these factors play their part in the determination of wages, but what is the balance between them? It is usually very difficult to identify the relative weight of one or the other factor because labour market conditions change gradually, so that wage differentials can change slowly in response to changing labour market conditions without compromising the motivational role of wages. In the case of the transition to a market economy in Russia, however, labour market conditions and wage differentials have changed dramatically. With the liberalisation of wages and prices, the degree of wage inequality increased from Scandinavian to Latin American levels, the Gini coefficient for the distribution of wages increasing from about 0.24 in 1964, to 0.31 in 1991 and to 0.45 since 1994. Employment in financial services almost doubled and in trade and catering increased by about half over the ten years of reform, while in some industrial branches employment fell by over 80%. A critical examination of the determination of changing wage differentials in Russia can therefore throw light on the different approaches of economists and sociologists to the differentiation of wages.}{\cs20\f17\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ The principal data used for this analysis is that published by the state statistical agency, Goskomstat, on the branch and regional breakdown of average wages, and the data of surveys conducted bi-monthly by the survey organisation VTsIOM, the more or less annual Russian Longitudinal Monitoring Survey (RLMS) and a household survey conducted by the Institute for Comparative Labour Relations Research (ISITO) in four cities in April-May 1998. }{\lang2057 For details of these data sets see }{Clarke, 1999}{\lang2057 , Appendix. The ISITO data is available through }{www.warwick.ac.uk/fac/soc/complabstuds/russia}{\lang2057 .}}}{\f17 
\par }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {\f16 Theories of wages
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {\f17 According to the economists\rquote  competitive labour market model, relative wages are determined by the supply and demand for particular qualities of labour. If labour were a homogeneous commodity, the wage would be as uniform as is the price of sugar, but labour is not homogeneous. Different individuals have different levels of aptitude, skill, education and experience that enable them more effectively to perform particular occupational roles, for which employers are willing to pay correspondingly higher wages. In a competitive labour market equilibrium we would expect to find wage differentials within and between occupations which reflect such differences in individual attributes and productivity. 
\par The accounts of sociologists and industrial relations specialists build on two distinctive features of the labour market. First, that people are not hired anew every day, but often work in the same job for many years, so that the wage relation is institutionally embedded to a much greater degree than other market relations. Second, that labour power is quite unlike other commodities in that, even when the contract has been signed, the employee still has to be persuaded to deliver the goods: the productivity of labour and the quality of the product depends on the motivation and commitment of the employees and on the cohesion of the labour force. The level and structure of earnings within the company plays a critical role in determining this motivation and commitment. 
\par The economists' model has never provided a very satisfactory empirical account of wages. On the one hand, in wage regressions only a relatively small amount of the variance of wages is explained by the relevant characteristics of individual employees: a significant amount of variance is explained by such ascriptive characteristics as sex and ethnicity, a significant amount by characteristics of the employer and a substantial amount always remains unexplained. Over the last two decades even competitive labour market economists have become aware that wages not only serve to clear labour markets, but also serve to recruit, motivate and retain employees. Economists have sought to reconcile the two functions of the wage by introducing the idea of an \lquote efficiency wage\rquote  as a premium that is paid above the market-clearing level with a view to motivating employees. However, even those economists who look beyond competitive labour market theory have tended to take a very narrow view of employees\rquote  motivation, emphasising the need to pay an efficiency wage primarily to give added teeth to the threat of dismissal. In this case the size of the wage premium is likely to be inversely related to the level of unemployment,}{\cs20\f17\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ In Russia, a very high level of wage inequality has persisted despite a substantial }{\i increase}{ in unemployment. As we will see below, there is no relation between the level or the change in relative regional wages and the rate of unemployment.}}}{\f17  but it is also likely to be larger where initiative and commitment is required and it is likely to be larger in jobs which are strategically important to the outcome as a whole, because in these cases it is more difficult to monitor the performance of the employee. 
\par These accounts imply that, at a given rate of unemployment, differences in the size of the efficiency wage will depend primarily on features of technology and so will vary between industries and occupations and in accordance with the size of plant, as is indeed the case. However, these differences cannot be explained by technological differences, most particularly because the premium paid in a particular industry is paid to all employees, regardless of their occupation (Kruger and Summers, 1988). Moreover, it turns out that the variance of wages between plants in the same industry tends to be much larger than the variance of wages between industries (Davis and Haltiwanger, 1991; Groshen, 1991) and although larger plants pay higher efficiency wages, so do larger firms regardless of plant size. Finally, the dispersion of wages within occupations is also high. In short, the implication is that technological factors play a relatively minor role in determining the size of the \lquote efficiency wage\rquote .
\par Sociologists emphasise the normative dimension of wage determination. The social organisation of work always combines the principles of hierarchy and collaboration and these principles are embedded in the pay structure of the firm, in which pay differentials are constrained by considerations of \lquote custom\rquote  and \lquote fairness\rquote  (Brown and Nolan, 1988). The wage is not simply the material remuneration received for doing the job, but is also a powerful symbol of the appreciation shown by the employer for the employee\rquote s efforts and of the relative status of that employee within the occupational hierarchy. Thus small pay differentials can have a considerable symbolic significance, as they did in the Soviet Union, while large differentials may be required to compensate for negative non-monetary status associations. This is one reason why the wage which employees consider fair and reasonable is usually determined in the first instance not by comparison with formally similar jobs with different employers, but by comparisons that are more immediate to the employee, between different positions within the pay structure of the same employer and between the level of pay today and that in the recent past. It is only if the employee feels that his or her pay has fallen behind that of other groups in the same workplace, or has fallen over time, that he or she begins to look around and make comparisons outside. Finally, we would expect employees to respond quite differently to the erosion of their pay level if they feel that this is the unavoidable consequence of external circumstances than if they feel it is merely an attempt of the employer to increase profits and managerial incomes at their expense. 
\par The sociological approach to wage determination implies that far from allowing market forces to dominate wage-setting, employers will actively try to insulate the level and structure of wages from the impact of changing market conditions. 
\par }\pard\plain \s25\qj\li238\sb120\sa120\sl-260\slmult0\nowidctlpar\adjustright \fs22\lang2057\kerning20\cgrid {\f17 A recurring theme of industrial relations research is that of a stable internal pay structure as a precondition for a compliant and co-operative workforce. This requires the internal pay structure to be well sheltered from the cross-currents of different occupational labour markets outside. Most large organisations appear to be able to achieve this (Brown and Nolan, 1988, p. 351). 
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {\f17 The determination of wages on the basis of custom, comparability and fairness implies, on the one hand, that there is a considerable rigidity in pay structures and payment levels since employees have a customary idea of the \lquote justice\rquote  of their relative wage and, on the other hand, that the level of wages in any particular firm will be conditioned as much by the firm\rquote s \lquote ability to pay\rquote  as it is by the wages paid elsewhere because this is the principle of justice that employees apply in evaluating their own terms of employment and which conditions their morale, commitment and work effort. The sociological approach implies that there will be a high degree of inertia in changes in both the level and the structure of wages and that the rate of increase of real wages will be related to the profitability of the employer.}{\cs20\f17\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ John Dunlop explained inter-firm wage differentials primarily by the extent to which differentials established in tight labour market conditions come to be \lquote regarded as proper\rquote  and \lquote are not readily altered in a looser labor market\rquote  so that the wage structure is institutionalised and \lquote the product market tends to be mirrored in the labor market and to determine the wage structure. The differentials are not transitory; they are not to be dismissed as imperfections\rquote  (Dunlop, 1957, p. 136). I am grateful to Mark Granovetter for drawing this reference to my attention.}}}{\f17  Surveys in western capitalist countries consistently show that the most important factors cited by employers in the determination of pay are compensation for increases in prices, the level of profits and the ability of the employer to pay, with comparability and retention playing a subsidiary role. Econometric analysis also finds that there is a very high degree of inertia in the determination of wages, that changes in wages are related to the firm\rquote s profitability and, in the short and medium term, to productivity, while there is much more limited support for the narrowly economistic conception of the efficiency wage (the evidence is surveyed in Layard et al., 1991, Chapters Three and Four, which develops a model that integrates some of the }{institutionalist}{\f17  insights). 
\par Such research as has been undertaken on the determination of individual wages in Russia has consistently found that a very large part of the variation of wages is not explained by the conventional indicators of education and work experience and that much of the variation remains unexplained even when a number of controls (including occupation, branch, region, sex) are introduced ((Brainerd, 1998; Gerber and Hout, 1998; Grogan, 1997; Newell and Reilly, 1996; Reilly, 1999}{\cs22\v\f17\fs16 {\*\atnid SC}{\*\atnauthor Simon Clarke}\chatn {\*\annotation \pard\plain \s24\qj\sb120\nowidctlpar\adjustright \fs20\lang2057\cgrid {\field{\*\fldinst {\f17 PAGE \\# "'Page: '#'\line '"}{\cs22\f17\fs16   }}{\fldrslt }}{\cs22\f17\fs16 \chatn }{\f17  Add the latest two}}}{\f17 ).). This evidence alone suggests that competitive labour market theory cannot account for the determination of wages in Russia. But is this a failure of competitive labour market theory, or is it a failure of the Russian labour market? We need to look more closely at wage determination in Russia to be able to approach an answer to this question. Our starting point is the orthodox interpretation of the Russian labour market, which derives primarily from analyses conducted by the World Bank\rquote s economists in the first years of reform.
\par }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {Russia meets the World Bank 
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {One of the first acts of the Yeltsin regime, in October 1991, was to free enterprises and organisations from the administrative regulation of wages, although wages in the budget sector (primarily public administration, health and education) continued to be determined according to administratively defined scales and most enterprises still used the official pay scales as the basis of their internal payment systems (Standing, 1996, p. 116). The immediate result of the greater freedom given to enterprises in the setting of wages was that the average money wage, which had taken twenty years to increase twofold between 1970 and 1990, then doubled between January and October 1991, doubled once more by December, making the freeing of state prices, most of which remained unchanged, inevitable. The wage inflation of 1991 was dwarfed by the inflationary explosion that followed the freeing of most prices at the beginning of 1992. Consumer prices increased by 26 times over the year and the average money wage by 13 times. Only small differences in the lag with which wages were adjusted to inflation could lead to very big differences in the real wage paid by different employers. Thus the dispersion of wages increased by about fifty percent between 1991 and 1992. The basic data on wage differentials is presented in Table 1.
\par }\pard\plain \s15\sb120\sa120\nowidctlpar\widctlpar\adjustright \i\lang2057\cgrid {{\*\bkmkstart _Ref449321681}{\*\bkmkstart _Toc451312085}{\*\bkmkstart _Toc456753731}Table {\*\bkmkend _Ref449321681}1: Real Wages and Measures of Wage Inequality{\*\bkmkend _Toc451312085}{\*\bkmkend _Toc456753731}
\par }\trowd \trgaph28 \clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx2297\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx2807\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx3317\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx3827\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx4337\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx4847\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx5357\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx5867\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6377\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6887\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx7397\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx7907\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 \page \cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 1964\cell 1980\cell 1990\cell 1991\cell 1992\cell 1993\cell 1994\cell 1995 \cell 1996 \cell 1997\cell 1998\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\trowd \trgaph28 \clvertalt\cltxlrtb \cellx2297\clvertalt\cltxlrtb \cellx2807\clvertalt\cltxlrtb \cellx3317\clvertalt\cltxlrtb \cellx3827\clvertalt\cltxlrtb \cellx4337\clvertalt\cltxlrtb \cellx4847\clvertalt\cltxlrtb \cellx5357\clvertalt\cltxlrtb \cellx5867\clvertalt\cltxlrtb \cellx6377\clvertalt\cltxlrtb \cellx6887\clvertalt\cltxlrtb \cellx7397\clvertalt\cltxlrtb \cellx7907\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Real wages (1985=100)\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 45\cell 87\cell 152\cell 147\cell 99\cell 99\cell 91\cell 66\cell 70\cell 73\cell 64\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Gini coefficient (*100)\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 24 \cell \cell \cell 31\cell \cell \cell 44\cell 45\cell 44\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 45\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 \cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Top decile wage share %\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 18\cell \cell \cell \cell \cell \cell 32\cell 34\cell 33\cell 33\cell \cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Bottom decile share %\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 5.4\cell \cell \cell \cell \cell \cell 1.4\cell 1.3\cell 1.4\cell 1.3\cell \cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Decile ratio of shares\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 3\cell \cell \cell 8\cell \cell \cell 23\cell 26\cell 24\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 25\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 \cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Ninth to first decile\cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 3\cell \cell \cell \cell \cell \cell 10\cell 10\cell 10\cell 10\cell \cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Dispersion (MLD) \cell }\pard\plain \qr\nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 \cell \cell \cell \cell \cell \cell }{\fs22\cf1 356\cell 383\cell 359\cell 369\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Regional dispersion \cell }\pard\plain \qr\nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22 18*\cell 18\cell 17\cell 20\cell 60\cell 58\cell 70\cell 70\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\fs22 70\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\fs22 70\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trgaph28 \clvertalt\cltxlrtb \cellx4337\clvertalt\cltxlrtb \cellx4847\clvertalt\cltxlrtb \cellx5357\clvertalt\cltxlrtb \cellx5867\clvertalt\cltxlrtb \cellx6377\clvertalt\cltxlrtb \cellx6887\clvertalt\cltxlrtb \cellx7397\clvertalt\cltxlrtb \cellx7907\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Regional dispersion deflated by prices \cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\fs22 46\cell 25\cell 29\cell 30\cell 32\cell 33\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trgaph28 \clvertalt\cltxlrtb \cellx5357\clvertalt\cltxlrtb \cellx5867\clvertalt\cltxlrtb \cellx6377\clvertalt\cltxlrtb \cellx6887\clvertalt\cltxlrtb \cellx7397\clvertalt\cltxlrtb \cellx7907\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Regional dispersion deflated by subsistence minimum \cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\fs22 26\cell 25\cell 24\cell 24\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trgaph28 \clvertalt\cltxlrtb \cellx2297\clvertalt\cltxlrtb \cellx2807\clvertalt\cltxlrtb \cellx3317\clvertalt\cltxlrtb \cellx3827\clvertalt\cltxlrtb \cellx4337\clvertalt\cltxlrtb \cellx4847\clvertalt\cltxlrtb \cellx5357\clvertalt\cltxlrtb \cellx5867\clvertalt\cltxlrtb \cellx6377\clvertalt\cltxlrtb \cellx6887\clvertalt\cltxlrtb \cellx7397\clvertalt\cltxlrtb \cellx7907\pard\plain \s23\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\fs22 Branch dispersion \cell }\pard \s23\qr\nowidctlpar\intbl\adjustright {\fs22 21*\cell }\pard\plain \qr\nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22\cf1 17\cell 22\cell 25\cell 71\cell 67\cell 77\cell 81\cell 78\cell 82\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\fs22\cf1 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard\plain \s26\qj\fi-709\li709\sb60\sa120\sl240\slmult0\nowidctlpar\adjustright \i\fs22\lang2057\kerning20\cgrid {Sources: * 1970. Figures calculated from data in Goskomstat, 1996; Goskomstat, 1998b (1980 and 1985 are not indexed for any price changes). Overall distribution indicators are calculated from decile distributions (1997 gini from more detailed data is 0.44 and mld is 384). Soviet Union: Redor 1992, pp. 55\endash 6. Dispersion is the mean log deviation (MLD) of the aggregate (from decile distributions), regional (76 regions) or branch (21 branches) mean wages relative to the average, weighted by employment (multiplied by 10}{\super 3}{ for clarity). The regional dispersion is also shown for income deflated by the regional subsistence minimum and by relative prices.
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {It was clear in 1992 that the Russian labour market was working, in the sense that wages and wage relativities had changed dramatically in response to the initial structural shock. But the key question was whether they were changing in response to labour market conditions, and whether employers and employees were responding appropriately to these differentials. This issue was addressed by the World Bank\rquote s team of economists, headed by Simon Commander, whose first response was that, by the standards of competitive labour market theory, they were not. Despite the acknowledged flexibility of the labour market and the responsiveness of workers to market stimuli, Russian employers fell far short of the market ideal in their wage-setting and employment behaviour. However, the basis on which the Bank\rquote s economists judged them wanting changed somewhat over time. The first diagnosis emphasised the supposed absence of any effective budget constraint on their behaviour. The second diagnosis concentrated on their supposedly irrational labour hoarding. The third diagnosis concentrated on their inappropriate wage-setting. In all three cases employers were charged with paying too much attention to the preferences of their employees and having insufficient regard to the requirement to maximise their profits.
\par }\pard\plain \s3\qj\sb320\sa320\sl240\slmult0\keepn\nowidctlpar\hyphpar0\outlinelevel2\adjustright \b\fs26\lang2057\kerning20\cgrid {Wages, employment and the soft budget constraint
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {The World Bank\rquote s economists set the agenda for those who followed. In their first analysis of the impact of radical reform they argued, drawing on a 1992 survey of 41 firms in the Moscow region and some analysis of aggregate data, that enterprises were playing a waiting game. On the basis of a rather selective reading of the aggregate data then available they claimed that real wages had been restored to their mid-1991 level by the middle of 1992 and that there had been very little fall in employment despite a dramatic fall in output. According to their analysis, uncertainty and \lquote insider power\rquote  meant that enterprise directors were reluctant to reduce employment, while by-and-large they were also able to maintain real wages because they were not subject to hard budget constraints, exploiting monopoly powers and extracting government subsidies to maintain real wages and return paper profits. They implied that the colossal inflation unleashed by price liberalisation was caused by a wage-price spiral. They did not believe that the wage-price spiral reflected any power of trade unions, but it did \lquote reflect the control structure and decision-making rules characterising the bulk of Russian firms\rquote  (Commander et al., 1993, p. 51). Changing wage relativities, they argued, were not related to labour market conditions, but only to the ability of the firm to extract money from banks and the government to meet the wage bill of the stable labour force.
\par The idea that inflation was driven by wage increases and that wage-setting was not subject to a budget constraint did not survive for long. It turned out that, on average, real wages had fallen substantially in 1992 and that profits had actually risen, so employers had not simply been able to extract money from banks or the government to pay the wage bill, but wages \lquote appear to have been primarily constrained by firm revenues (and subsidies)\rquote  (Commander et al., 1995, p. 177).}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\lang2057\super \chftn }{\lang2057  In fact the World Bank\rquote s 1994 survey found that only 25-30% of enterprises received federal subsidies during 1992-4 (}{Commander et al., 1996}{\lang2057 , p. 22). }}}{ Relative wages were not determined simply by the ability to extract subsidies, but showed the expected relation to changes in production and relative prices and were also correlated with profits (ibid., p. 167; Commander et al., 1996). Although there were some signs of a softness in the budget constraint with regard to wage-setting for some firms in 1992 and 1993, by 1994, for the overwhelming majority of firms, the World Bank\rquote s 1994 enterprise survey concluded that \lquote wage settlements were clearly constrained by the operating surplus\rquote  so that \lquote firms have generally been quite effectively constrained in their wage setting by their revenues and they do not appear to have operated as if in the presence of a soft budget constraint\rquote  (Commander et al., 1996, p. 45).
\par }\pard\plain \s3\qj\sb320\sa320\sl240\slmult0\keepn\nowidctlpar\hyphpar0\outlinelevel2\adjustright \b\fs26\lang2057\kerning20\cgrid {Labour hoarding
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {The observation that enterprises were adjusting to falling revenue by reducing wages, while total employment fell by much less than the decline in production, led to the idea that enterprises were hoarding labour. All sorts of economic, social, ideological and political explanations for this phenomenon were assembled, but the most general was the claim that labour hoarding was an expression of enterprise paternalism as directors responded to employees\rquote  preferences. Simon Commander and his colleagues explained this supposed \lquote labour hoarding\rquote  in terms of a model of a worker-controlled firm (Commander et al., 1996, pp. 184\endash 9), although they recognised that trade unions do not play an adversarial role, that managers have complete discretion in setting wages, that worker-shareholders enjoy no effective rights and that there is no observable difference in behaviour between state, privatised and new private firms or between those firms which are insider- or outsider-controlled. They similarly characterised the willingness of Russian workers to work for much reduced wages, to suffer short-time working and lay-offs without pay and to endure the non-payment of wages for months on end as being based on an \lquote implicit contract between workers and managers. Workers accept highly flexible wages and hours, and managers may in return offer a high degree of job security\rquote  (Commander et al., 1996, p. 86). However, this was a mis-characterisation of what was already a pretty one-sided contract, since the managers did not offer employment stability or job security in exchange for low wages. The belief that they did is a simple fallacy of composition: those keeping their jobs were not those taking the cut in wages. At the level of the firm, there is a strong positive correlation between the fall in wages and decline in employment (Commander et al., 1996, p. 28): those firms in difficulties cut both wages and employment, the more prosperous firms were able to offer both stable wages and stable employment. Similarly, those firms which paid low wages had much the highest labour turnover,}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\lang2057\super \chftn }{\lang2057  }{Aukutsionek and Kapeliushnikov, 1994}{\lang2057  showed that in 1993 enterprises with low wages had a much higher quit rate but about the same rate of lay-offs and hiring as those which paid high wages. However, even the low-wage employers do not have much trouble filling the vacated jobs: almost half reported having more applicants than they had vacancies. }}}{ often at annual rates of more than one hundred percent. It is only when wages are so low that the employer cannot find anybody else to take the job that the worker enjoys any security. Otherwise the increasingly familiar cry echoes in her ears, \lquote if you don\rquote t like it, you can go\rquote , and many do, usually to take a job with little better pay and conditions somewhere else.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\lang2057\super \chftn }{\lang2057  I have discussed this issue at length in }{Clarke, 1998a}{\lang2057 . On management employment strategy see }{Clarke, 1999}{\lang2057 , Chapter Two. Sergei Aukutsionek and}{\f10\fs24\lang2057  }{\lang2057 Rostislav Kapelyushnikov have shown that surplus labour is retained because the costs of retaining a reserve of labour are less than the costs of more rapid reduction. The scale of the reserve is not substantial: with a stabilisation of production it would be liquidated within three years (}{Aukutsionek and Kapelyushnikov, 1996a; Aukutsionek and Kapelyushnikov, 1996b}{\lang2057 ). Thus \lquote labour hoarding\rquote  in Russia appears to be no different from in any other economy. }}}{ 
\par This pattern of wage setting may not correspond to the prescriptions of competitive labour-market theory, but it is exactly that which is observed by industrial sociologists and industrial relations specialists in western companies. It is not necessary to go to the lengths of postulating a model of a worker-controlled firm to recognise that employers have to take employees\rquote  preferences into account in determining their wage and employment policies, not only because their policies affect employees\rquote  behaviour in the labour market but because they affect their behaviour in the workplace. It is the latter consideration which means that employers cannot set wages in accordance with labour market considerations alone (Brown and Nolan, 1988). In a labour market which has seen a total reduction of employment of about one quarter since 1990, and turnover of around 25% a year, Russian employers are marked, if anything, by the very limited extent to which they choose or are compelled to take their employees\rquote  preferences into account, but they do have to take account of the impact of the level and structure of wages on the productivity of the \lquote labour collective\rquote .
\par There is no need to postulate a worker-controlled firm or an implicit contract to explain the fact that the structural shock has been absorbed as much or more through a fall in wages as through employment reductions.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\lang2057\super \chftn }{\lang2057  }{Layard and Richter, 1995}{\lang2057 , pp. 95-6 showed that over the period 1991-2 industry wages fell by 2.4% for every 1% extra fall in employment, a remarkably high elasticity by international standards. Rostislav Kapelyushnikov has provided a systematic comparison with the other ECE countries, showing the distinctiveness of Russia (and the Czech Republic) in the apparent degree of wage and employment flexibility (}{Kapelyushnikov, 1999}{\lang2057 ).}}}{ Particularly in a situation in which compulsory lay-offs impose significant social and economic costs we would expect that employers would much prefer to cut wages in response to a fall in demand, drawing the double benefit of encouraging cuts in the labour force by natural wastage and reducing the cost of employing those who remain. Commander and his colleagues recognised that rather than lay people off, employers were \lquote using the }{\i threat}{ of unemployment to force down wages\rquote  (Commander et al., 1995, p. 183), but ignored the corollary, that workers who could get better jobs would then vote with their feet when wages fell, to such an extent that low-wage employers had to maintain high hiring rates to replace essential workers even if they were cutting total employment sharply. When wages have fallen by half or more, so that they now account on average for less than 10% of current costs in industry, it should not be surprising to find that employment does not fall }{\i pro rata}{ with the fall in production since it is not worth the cost and disruption of reorganisation and redeployment that planned employment reductions involve. 
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {Although the idea that labour hoarding is endemic in Russian enterprises has gained wide currency, there is no evidence that Russia is in any way exceptional in the extent to which the fall in employment has lagged behind the fall in production. According to revised data, the fall in production in 1992-3 was substantially less and the fall in employment rather more than was originally reported. Since 1993 the fall in employment has more or less shadowed the fall in production and GDP, gradually making up the gap (Clarke, 1999, p. 298).
\par What is distinctive about Russia is not the desire of employers to cut wages but the lack of overt resistance to wage cuts. People work for low wages in Russia for the same reasons that they work for low wages anywhere else in the world: they have no better alternative. It is the scale of the macroeconomic shock to which the Russian economy and its labour force has been subjected and the absence of any effective trade union representation or legal or social protection, that has made the Russian labour market \lquote perfectly flexible\rquote  (Aslund, 1996). The surprise for a competitive labour market economist is not that real wages have fallen, but that many employers have continued to pay wages well above the market-clearing rates. The implication is that sociological factors predominate in determining that wage structures remain relatively stable, to the extent that employers are able to pay established wage rates, while labour market factors seem to predominate only in the case of employers who are under severe financial pressure to cut costs.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ Many Russian employers experiencing cash-flow constraints delay the payment of wages. This is a complex phenomenon that I will not consider here (Clarke, 1998b; Earle and Sabirianova, 1999).}}}{ The tendency for those who can afford it to pay relatively high wages is not an idiosyncratic feature of paternalistic soviet directors, since wages in the new private sector are significantly higher than in traditional enterprises, while foreign-owned enterprises pay much the highest of all wages (in the data of the Russian polling organisation, VTsIOM, foreign-owned enterprises pay on average well over three times as much as state enterprises).
\par }\pard\plain \s3\qj\sb320\sa320\sl240\slmult0\keepn\nowidctlpar\hyphpar0\outlinelevel2\adjustright \b\fs26\lang2057\kerning20\cgrid {Wage flexibility and wage setting
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {While employers did not respond to the crisis in the way that the World Bank\rquote s economists believed that employers should, workers also confounded their expectations. The initial belief had been that workers would be reluctant to change jobs in response to emerging pay differentials because of the wide range of welfare and social benefits attached to long-service and stable employment in state enterprises. In fact, however, the workers surprised the economists by their readiness to change jobs in response even to ephemeral changes in relative wages (Commander et al., 1995, pp. 160\endash 61), to the extent that Aukutsionek and Kapeliushnikov, 1994, concluded that \lquote in 1993 workers were behaving in a much more market-oriented fashion than were enterprises as employers\rquote  (p. 30). The OECD, in its country report on Russia, concurred that \lquote the labour force has exhibited a high degree of flexibility\rquote  and that \lquote real wages showed remarkable flexibility\rquote  (OECD, 1995, pp. 109, 113). In regard to labour market flexibility, Russia, against all expectations, \lquote conforms better to the OECD\rquote s recommendations than any OECD country\rquote  (Layard and Richter, 1995, p. 40).
\par Wages may be flexible, but this does not necessarily mean that they are performing their appropriate economic function of redeploying labour from less to more productive uses. The World Bank team\rquote s analysis of the findings of their 1994 enterprise survey concluded that \lquote wage decisions appear to be conditioned primarily by firm-specific financial variables, liquidity and profitability, but also appear sensitive to … the need to pay competitive wages to maintain attachment. But the most important consideration is the explicit association of wages with consumer price changes\rquote  (Commander et al., 1996, p. 31). In other words, employers\rquote  prime concern was to preserve the real value of wages, subject to their ability to pay and the need to recruit and retain labour, displaying their commitment to the well-being of their employees rather than taking advantage of more favourable labour market conditions, as competitive labour market theory implies that they should. The result was that, despite enormous changes in relative prices and production levels, the structure of branch and regional differentials had not changed substantially, while skill differentials appeared hardly to have changed at all, the main changes in relativities being due to inter-firm differences in liquidity and profitability. Simon Commander and his colleagues concluded that this stability of differentials \lquote indicates the power of institutional features in the wage setting\rquote  (Commander et al., 1995, p. 165). 
\par }\pard\plain \s21\qj\sl240\slmult0\nowidctlpar\adjustright \fs26\lang2057\kerning20\cgrid {\fs24 The diagnoses of the World Bank team in the early years of reform were soon established as the orthodox interpretation of the development of the Russian labour market, reflected in subsequent commentaries of western economists and international organisations such as the World Bank and the OECD.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ The principal, and honorable, exception was the ILO team, led by Guy Standing, whose annual Russian Labour Flexibility Survey, which was much more rigorous and systematic than the }{\i ad hoc}{ enterprise surveys conducted on behalf of the World Bank, painted a very different (and much more realistic) picture of the Russian employment situation (Standing, 1996).}}}{\fs24  It became a commonplace that Russian employers were paternalists, responding to their employees\rquote  aspirations for job security by maintaining employment at the expense of the inflationary erosion of real wages and able to do so as a result of the persistence of soft budget constraints. The implication was that Russian employers had to be forced to behave in a more market-oriented fashion by subjecting them to the more rigorous financial discipline that would compel them to confine wages within the limits of profitability and to dispense with surplus employees. Yet, the evidence suggested that, however much labour economists might disapprove, Russian employers were behaving in very much the way that western employers behave, attempting to maintain productive efficiency and what Russian employers refer to as the \lquote manageability\rquote  of the labour force by preserving the existing wage structure as best they could in the face of dramatic changes in the labour market and macroeconomic environment. However, these analyses were based only on data relating to the first stages of transition. Before drawing any firm conclusions we need to look at the subsequent development of wage differentiation in Russia and a wider range of data, in case this inertia was only an ephemeral phenomenon.  
\par }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {Branch and Regional wage differentiation
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {The dramatic changes in wage differentiation in Russia appear to have been concentrated in the period 1991-2, while the pattern and degree of wage inequality has remained remarkably stable since 1994 (Table 1). We can get some indication of the factors involved in the determination of wages by looking at the changing branch and regional structure of wages. A series of OLS regressions was run to explore the relationship between changes in wages and changes in a number of independent variables.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ Branch and regional data (the only wage data for which a continuous series extending back to the pre-reform period is available) is published in Goskomstat, 1998a and Goskomstat, 1998b. A large number of different specifications of regressions were run on the annual data with a range of indicators of explanatory variables and a variety of lags. The results reported in the text are robust across a wide range of specifications.}}}{ These regressions confirmed the earlier findings in giving very little indication of responsiveness of wages to labour market conditions.
\par Regional wage variations in the soviet period were primarily connected with the payment of branch and regional premia to encourage people to work in the priority branches of production and in the more inhospitable regions. An OLS regression shows that almost two-thirds of the regional variation of wages in 1990 is explained by differences in the branch structure of employment in various regions, low-wage regions being those dominated by low-paying industries. Although the scale of regional wage differentials increased considerably between 1990 and 1994, this appears to have been primarily an inflationary process triggered by the wage premia inherited from the soviet period, which led to substantial regional differences in rates of inflation culminating in big regional differences in both price and wage levels so that, as can be seen in Table 1, regional wage inequality is much less when deflated by a regional price index. According to the official statistics, since 1991 prices in Kamchatka have risen by seven times as much as prices in Kaliningrad, while both prices and nominal wages are now three times as high. 
\par The impression that increased regional wage differentiation is a feature of an inflationary process rather than a reflection of different labour market conditions is confirmed by the fact that the structure of regional wage differentials is very stable: there is a strong correlation between the structure of wages across 78 regions in 1997 and the structure at the beginning of the Brezhnev era in 1970 (Spearman coefficient is 0.89), while the correlations with wages in 1980 and in 1990 are hardly any greater, at 0.91 and 0.90 respectively (the correlation with 1994 is 0.97). It appears that historically established regional pay differentials have simply been expanded as a result of the inflationary process. 
\par About half of the total wage dispersion between regions is accounted for by differences in the regional cost of living and a further ten percent by differences in the structure of employment. The only other factors that are significantly related to changing regional wage differentials are increases in profits in the period 1991\endash 2 (profits at that time will have been closely related to export opportunities and so to differences in the branch structure of employment), and changes in production and employment since 1994. Over the whole period from 1990 to 1997 it turns out that the bulk of the regional wage structure is explained by the regional wage and employment structure inherited from the soviet era, but relative changes in production and employment, which are not significantly correlated with one another, have both had some impact on wages. However, any suggestion that this is an indicator of a responsiveness of regional wage differences to changing labour market conditions is undermined by the fact that there appears to be absolutely no relationship between changes in wages and the rate of ILO unemployment at the regional level. 
\par If we turn to branch differentials we also find a remarkable stability in the structure of pay differentials, with most structural changes taking place in the late perestroika era, while price liberalisation led to a sharp widening of differentials but little structural change. Since 1994 there has been a marked stabilisation of the structural relations between branches of the economy and changing wage relativities seem to have been more closely associated with changes in production and employment and with the relative success and failure of particular employers. 
\par Most of the structural change in branch wages took place in the late perestroika period: the Spearman correlation coefficient between relative wages in 21 branches in 1970 and 1990 is 0.87 and that between 1993 and 1997 is 0.92, but the correlation between wages in 1993 and wages in 1990 is only 0.80 and between 1990 and 1991 it is only 0.83. The increased dispersion in 1992 represented a widening of existing inequalities rather than any dramatic changes in the wage structure. It seems fairly clear that the first wave of wage adjustment expressed the traditional status hierarchy of branches and occupations, widening differentials that had been suppressed by administrative controls. 
\par This opening of differentials does not appear to have had much connection with labour market conditions. There is a correlation between changes in relative wages and relative changes in employment at the beginning of the transition (the correlation coefficient between the change in wages and change in employment across 21 branches between 1990 and 1992 is 0.63, significant at the .001 level), although the correlation subsequently is much weaker. However, there is no indication of the direction of the causality underlying this relationship. In particular, it is equally consistent with an \lquote competitive labour market\rquote  explanation, according to which higher wages are required to attract more labour, and a \lquote sociological\rquote  explanation, according to which the more prosperous branches are better able to maintain both wages and employment of their current employees regardless of the state of the labour market. 
\par There is no significant relationship between changes in employment and changes in output and no significant relationship between changes in output and changes in wages across the ten industrial branches in this early period. This suggests that the labour market was not serving to transmit the impact of product market shocks to the labour force, for the scale of the cuts in wages was not related to any attempt of management to reduce employment in line with falling production. Indeed, although output fell in all branches, employment increased in the majority over 1990-2. It looks as though those industries which had traditionally faced labour shortages initially took the opportunity to increase both their wages and their employment, despite falling output, while those industries already experiencing severe financial pressures did not hurry to increase wages to compensate for inflation, with the result that their employment fell since their low wages meant that they were not able to match staff losses by increased hiring. Output changes are strongly correlated with employment changes across the industrial branches over the period 1992-7, and are correspondingly weakly correlated with the change in wages, but there is no significant relationship between the change in wages and change in productivity, so that workers in those branches which retained labour in relation to changing production were no more likely to experience a decline in wages than those in branches which were more vigorous in reducing the labour force, which is further evidence undermining the hypothesis that Russian workers have chosen to take a cut in wages as the price of retaining their jobs (Commander et al., 1996; Layard and Richter, 1995).}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\f17\super \chftn }{ \tab If people traded job security for low pay, then we would expect to find that those with long job tenure would have significantly lower wages than those who have taken their jobs more recently. In the data of the ISITO household survey, controlling for occupation}{\lang2057 ,}{ }{\lang2057 sector, }{branch of the economy}{\lang2057  and socio-demographic variables, those who have not changed job since 1991 earn on average 12% more than those who have done so}{.}{\lang2057  }{The aggregate data, as well as that disaggregated by branch, strongly supports the findings of our case studies, that wage and employment reductions are not alternatives but complements: those workers who enjoy employment stability also enjoy high pay, while those who have the most insecure employment also have the lowest pay. Low pay is a fate suffered by those condemned to work in the least prosperous branches, it is not an option which is offered in exchange for security of employment.}}}{ 
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {The suggestion that employment reduction is a result of decisions taken by workers in the face of falling wages rather than decisions taken by managers to reduce employment is supported by the data on labour turnover: changes in wages are correlated with the change in the quit rate experienced by the industry, although not with the change in the hiring rate. From 1994, there is an increasingly strong correlation between the decline in wages and the percentage of loss-making enterprises in the branch, which again corroborates the impression that wages are determined more by the ability of the employer to pay than by the labour market situation.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\f17\super \chftn }{ }{\lang2057 \tab }{In a series of OLS regressions none of the }{\lang2057 other }{independent variables for which we have reasonable data, apart from profits, prove consistently significant, and the coefficients are not very stable. Monopoly power, measured by the proportion of the home market supplied by eight enterprises, is not significant in either period (tending to discount the suggestion that increased wage differentials arise from the participation of workers in monopoly rents, Brainerd, 1998, p. 1110), nor are the capital-output }{\lang2057 n}{or capital-labour ratios }{\lang2057 n}{or the rate of investment, nor the proportion working in hazardous conditions, nor the property form nor the extent of small business activity nor the scale of non-payment of wages}{\lang2057 ,}{ with a range of different specifications of lags. No \lquote human capital\rquote  variables (age, sex, educational level of the labour force) are significant. }}}{ 
\par There is no evidence from the pattern of change in the wage relativities between branches that increasing pay differentials represent either an increase in differentials in favour of \lquote human capital\rquote  or a means of adjusting to labour market imbalances. The overwhelmingly most powerful factors determining wage relativities today are wage relativities in the past, tempered by the ability of the enterprise to pay wage increases to compensate for inflation out of current revenues, or by incurring debt, or by reducing the labour force in the wake of a fall in production. This suggests that the most important factors are actually firm-specific. However, before we dismiss the competitive labour market explanation for the changing pattern of pay differentials, we have to consider the possibility that these differentials are the result of labour market disequilibrium resulting from barriers to labour mobility.
\par }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {Persistent inequality and barriers to labour mobility
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {The persistence of the very substantial wage inequalities that opened up in the early transition crisis might indicate to an economist that there are significant barriers to labour mobility that are preventing the erosion of these differentials. The first suggestion of orthodox western economists was that people were reluctant to leave their jobs because their workplace provided them with housing and a wide range of social and welfare benefits, an idea that could hardly be reconciled with the fact that almost a third of people were leaving their jobs each year. Nevertheless, western advisers pressed the Russian government to compel enterprises to divest their housing and social and welfare facilities, transferring them to municipal authorities which had neither the staff, nor the funds, nor the managerial skills to continue to provide them (Healey et al., 1998). The result of this policy was to accelerate the collapse of the construction and maintenance of housing, the social infrastructure and the provision of marketable services to the population without having any discernible impact on labour mobility. 
\par When these policies had no impact on the labour market, many commentators turned their attention to the barriers to labour mobility supposedly constituted by the limited housing market, believing that the high levels of wage inequality were primarily a result of regional wage inequalities associated with dramatic changes in the geographical structure of the demand for labour. However, although the registered unemployment rate is still very low, there is no evidence of significant regional labour shortages (total employment has fallen even in Moscow city), while we have seen that most of the regional dispersion of wages can be explained by differences in the cost of living and in the branch structure of employment. On the other hand, there is a relatively high level of inter-regional mobility, with around three million people a year moving within Russia, almost half of whom move between regions,}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\lang2057\super \chftn }{\lang2057  \tab According to the 1994 microcensus data, the principal motives for moving are for reasons of employment and education. Louise Grogan reports an unpublished study by Annette Brown which shows that immigration within Russia has responded positively to regional wage differentials, with out-migration responding negatively (}{Brown, 1997}{\lang2057 , cited in }{Grogan, 1997}{\lang2057 ). See also }{Kapelyushnikov, 1999}{\lang2057 , pp. 13-14.}}}{ in addition to which there are around half a million officially registered net immigrants to Russia each year, mostly from the other former Soviet Republics (Goskomstat 1998a). Finally, wage inequality within each region is substantially greater than inequality between regions. Decomposing the overall measure of wage inequality by region, using the mean log deviation as an additively decomposable indicator (Jenkins, 1995), shows that 18% of inequality is accounted for by wage differences between regions and 82% by wage differences within regions (Table 1). However, almost half of the difference in nominal wages between regions is accounted for by differences in the regional consumer price indices and 15% by differences in industrial structure, so that in real terms well over 90% of wage inequality is accounted for by differentiation within regions. It is clear that most people have a far higher chance of increasing their pay by taking a better-paid job within their own region than by taking an equivalent job in another region, even if there were no barriers to geographical mobility. We can conclude that there is no evidence that there are significantly more barriers to regional mobility than are usual in any comparable capitalist country and that this is not a significant source of wage inequality.
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {The other obvious barrier to labour mobility in a situation of rapid change is the training that is required for people to take up a job in a new occupation or a new sector of the economy. There is no doubt that the soviet system of occupational training has largely broken down and a system adequate to the new market economy has only slowly emerged to take its place.}{\cs22\v\fs16  }{On the other hand, it is important not to exaggerate the extent of the demand for new skills. Russia is a constantly declining economy, which has lost around a quarter of its jobs since 1990, while Russia has a highly educated and highly trained labour force. A substantial proportion of the jobs being lost are the most highly skilled jobs, while most of the new jobs being created demand skills which can be easily and quickly acquired (Clarke and Metalina, 2000). The number of jobs lost in the highly skilled branch of science and technology since 1990 is almost four times as many as the number of jobs created in the financial sector. The engineering industry has lost about half its jobs, which is half as many jobs again as have been created in the expanding sphere of trade and catering. We have already noted that research on wages in post-soviet Russia has consistently shown only a small return to either education or experience, indicating that there is no shortage of skills. Although labour turnover is relatively high, most involves people shuffling between existing jobs, with very low rates of job creation (Kapelyushnikov, 1997; Kapelyushnikov, 1999). While large and medium enterprises still hire at a rate of around 20% per annum, typically only around 5% of these hires are to newly created jobs, the remaining 95% are filling vacancies created by previous quits.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\f17\super \chftn }{ }{\lang2057 \tab On the basis of administrative reporting in four regions in 1996 }{Gimpel'son and Lippoldt, 1999}{\lang2057  report that net job creation in expanding firms amounted to 1.9% of total employment, net job destruction in contracting firms to 11.1% so that job turnover altogether accounted for about 20% of labour turnover. This is within the range of relatively stable OECD countries, but less than half the rate of Poland, and is dominated by job destruction. However, it is in line with the other transition countries if we confine our attention to the contraction phase (}{Kapelyushnikov, 1999}{\lang2057 , p. 52).}}}{ Job creation in the new private sector is at a substantially higher rate (Clarke and Kabalina, 2000), but labour turnover also appears to be much higher in the new private sector. Thus, a large proportion of labour market activity involves \lquote churning\rquote  and only a very small proportion involves any transition to new jobs or new forms of employment. 
\par As we have seen, the dispersion of wages between industrial branches has increased substantially since 1990, but wage inequalities within industry groupings are even greater than inequalities between industries: those working in banking and finance earn on average three times as much as those working in agriculture, but the top 10% in banking earned thirty times the wages of the bottom 10%. If we decompose the mean log deviation of wages, we find that within-branch variation of wages accounts for about three-quarters of inequality, the variation between branches for only 23%. The immediate conclusion that a labour economist would draw from this finding would be that there must be large occupational pay differences underlying the growth of inequality in the Russian economy. However, we should not rush to such a conclusion without considering the evidence.
\par The official data indicates that increased wage inequality has not been associated with a dramatic increase in occupational pay differentials. The Goskomstat survey of occupational wages has reported on the relative wages of the same set of mostly skilled occupations in 1993, 1994, 1995 and 1997.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\f17\super \chftn }{ }{\lang2057 \tab Unfortunately we do not have comparable data on the structure of occupational wages before 1993. However, a series of World Bank surveys of enterprises found that \lquote dispersion in wages over sectors and skills that increased rapidly in 1991 was, if anything, dampened in 1992\rquote  (}{Commander et al., 1995,}{\lang2057  p. 166).}}}{ The impression given by this data is that, outside the energy and aviation sectors, skill differentials are still not particularly large, with very few occupations paying more than twice the average pay. The dispersion of earnings of the surveyed occupations has been falling since 1993, although the change is not dramatic, but the selection of occupations is by no means representative so that few conclusions can be drawn from examination of this data. Goskomstat in 1997 also surveyed the pay of enterprise directors, finding that around three-quarters earned (or claimed to earn) less than five times the average pay in their enterprise (Goskomstat, 1998b). 
\par If we turn to the available survey data we find that it paints a very consistent picture \endash  the bulk of pay differentiation is not between but within occupations. Table 2 shows a breakdown of the dispersion of wages into components accounted for by the dispersion within 4-digit occupations in each survey location, the dispersion between occupations in each location and the dispersion between locations for data from the regular surveys of VTsIOM and RLMS and the 1998 ISITO survey.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\f17\super \chftn }{ }{\lang2057 \tab }{The MLD is quite sensitive to extreme cases at the bottom of the distribution, so the precise figures should not be taken too seriously, but the cited figures if anything understate the dispersion within occupational categories. The figures shown in the table are based on all those occupations in which more than one person is employed at the relevant location. For RLMS the locations are the 160 interviewing sites, for VTsIOM the 11 Russian regions, although the breakdown by oblast and by population centre (200 different qnaspun, which seem to correspond to polling sites) is almost identical. The ISITO data is only across four cities. Restricting the selection to a minimum of either five or ten cases substantially increases the dispersion within occupations but reduces the data and restricts it to larger population centres. The RLMS and VTsIOM data provides information only on the wage received in the previous month, which means that the non-payment of wages creates problems. The problem is evaded here by including only those respondents who said that they were paid their last wage in full and on time, who had no wages owed to them and had experienced no periods of compulsory leave in the current year (this latter information is not available for the VTsIOM data). This also substantially reduces the dispersion within occupations. In the ISITO survey respondents were asked both about the }{\lang2057 average}{ monthly wage and about the \lquote normal\rquote  wage. The latter is used as the basis for }{\lang2057 the}{ figures reported here. Using hourly wages instead of monthly wages (the VTsIOM data set does not include information on hours worked) also increases the dispersion within occupations, but payment by the hour is still very much the exception in Russia. }{\lang2057 No correction has been made for regional price differences in computing the MLD. In the ISITO survey these are not substantial, but in the RLMS data almost half the total variation in wages is accounted for by variation between sites. The VTsIOM data is bi-monthly. The data has been corrected for price changes using the consumer price index for the month in question and then normalised each year to eliminate seasonal fluctuations and trend changes in wages to give an equal average wage each month.}}}{ The data clearly shows that about half the dispersion of wages in local labour markets is within four-digit occupations. If we take the full VTsIOM dataset for 1993-7 we find that the dispersion is high across all 399 occupations covered. It is slightly higher for senior managerial, skilled agricultural and unskilled manual occupations, and slightly lower for public service occupations but otherwise there are no striking differences between branches or occupational categories, nor are there any such differences in the ISITO survey data. There are no significant differences over time. 
\par Although a cleaner in a bank is paid far more than a cleaner in a hospital, differences in branch affiliation do not account for the majority of the differences in wages in the cities covered in the ISITO survey. As can be seen in Table 3, which breaks down the mean log deviation by three-digit branch and four-digit occupation, differences in pay for the same occupation in the same branch account for between forty and fifty percent of the total wage inequality in each city, and for substantially more than differences between occupations within the branch. It would appear that we are dealing with a general phenomenon across all branches and occupations, not one specific to particular kinds of jobs, particular production technologies or particular market situations, as would be implied by theories of labour market segmentation or \lquote efficiency wages\rquote .}{\cs20\fs20\super  \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\lang2057\super \chftn }{\lang2057  \tab The other commonly used indicator of dispersion is the coefficient of variation (CV). In the ISITO survey the CV of hourly wages within four-digit occupations across all occupations for which we have more than one case in each city, excluding all those with wage delays or leave, was 54%, the range between cities being from 53\endash 56%. In the RLMS data the CV across occupations was 50% in 1994, 47% in 1995, 45% in 1996 and 41% in 1998, controlling for site, in the VTsIOM data around 60%, controlling for region, between 1993 and 1996, without any significant trend over time. This compares to a CV within occupations of 16\endash 23% in a UK study of engineering firms in 1966 and CVs of 11%, 13% and 15% for fork-lift drivers in Adelaide, Coventry and Chicago (cited }{Brown et al., 1995}{\lang2057 ). Clark Kerr cites studies of Lester and Reynolds on the wartime US labour market which found that high-wage employers normally paid about 50% more than low-wage employers for the same occupation, although he noted that the more normal dispersion found in peace-time studies was 25% from top to bottom (}{Kerr, 1997}{\lang2057 , p. 150).}}}{
\par }\pard\plain \s15\sb120\sa120\nowidctlpar\widctlpar\adjustright \i\lang2057\cgrid {{\*\bkmkstart _Ref456450510}{\*\bkmkstart _Toc456753732}Table 2:{\*\bkmkend _Ref456450510} Decomposition of wage inequality within and between occupations.{\*\bkmkend _Toc456753732} 
\par }\trowd \trgaph85\trrh250\trleft-85 \clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx1177\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx1788\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx2639\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx3686\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrl\brdrs\brdrw15\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6516\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrl\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx7347\pard\plain \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\cell }\pard \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright {\cell Total\cell MLD\cell Percentage of total MLD\cell \cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\trowd \trgaph85\trrh250\trleft-85 \clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx1177\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx1788\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx2639\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx3686\clvertalt\clbrdrl\brdrs\brdrw15\brdrcf15 \clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx5076\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \clbrdrr\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6516\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx7347\pard\plain \s23\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\cell \cell MLD\cell within location\cell within occupation and location\cell between occupations within location\cell }\pard \s23\qc\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright {N\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\trowd \trgaph85\trrh250\trleft-85 \clvertalt\cltxlrtb \cellx1177\clvertalt\cltxlrtb \cellx1880\clvertalt\cltxlrtb \cellx2598\clvertalt\cltxlrtb \cellx3686\clvertalt\clbrdrl\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx5076\clvertalt\clbrdrr\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx651