cell 0.039\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \qj\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Lyubertsy\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.175\cell -0.025\cell 0.041\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx8647\pard \qc\nowidctlpar\widctlpar\intbl\adjustright {\b\i\fs22 Occupation-level variables\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx5103\clvertalt\cltxlrtb \cellx6352\clvertalt\cltxlrtb \cellx7558\clvertalt\cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Proportion of men in four-digit occupation\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.438\cell 0.059\cell 0.053\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Proportion with higher education in occupation\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.291\cell 0.091\cell 0.085\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx5103\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Occupational status (Skilled worker is reference)\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx5103\clvertalt\cltxlrtb \cellx6352\clvertalt\cltxlrtb \cellx7558\clvertalt\cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Managers\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.060\cell 0.174\cell 0.072\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Professional\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.211\cell 0.044\cell 0.078\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Low specialist\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.119\cell -0.106\cell 0.055\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Admin./commercial\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.086\cell -0.029\cell 0.056\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Service staff\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.109\cell -0.267\cell 0.057\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Unskilled worker\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.166\cell -0.171\cell 0.045\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\clbrdrt\brdrdb\brdrw15 \cltxlrtb \cellx5103\clvertalt\clbrdrt\brdrdb\brdrw15 \cltxlrtb \cellx6352\clvertalt\clbrdrt\brdrdb\brdrw15 \cltxlrtb \cellx7558\clvertalt\clbrdrt\brdrdb\brdrw15 \cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Total Variance within occupations\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 0.320\cell 0.009\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx5103\clvertalt\cltxlrtb \cellx6352\clvertalt\cltxlrtb \cellx7558\clvertalt\cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Total Variance between occupations\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 0.123\cell 0.013\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Residual Variance within occupations\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 0.263\cell 0.007\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Residual Variance between occupations\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 0.021\cell 0.004\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 N\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 2982\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Initial -2LL \cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 5541.018\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx5103\clvertalt\clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx6352\clvertalt\clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx7558\clvertalt\clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 -2LL \cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 \cell 4643.273\cell \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {Wage determination and management structures
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {The Russian labour market in transition was marked by a dramatic increase in pay differentials immediately following the freeing of wages and prices from administrative control, the scale of which has remained at a similarly high level throughout the period of reform. Despite the limitations of the available data, we have shown that the structure of wage differentials that has developed in Russia does not seem to be primarily the result of labour market processes, since changing differentials bear little relation to changes in the demand for labour, while only a very small part of wage differentials appear explicable in terms of differences in human capital. Nor are persistently high differentials a result of barriers to labour mobility, since the majority of differentiation is within occupational and industrial groupings within local labour markets. 
\par The bulk of the evidence suggests that changes in relative wages are to be explained primarily by firm-specific variables, with many employers deciding at least partially to maintain the real value of wages in the face of inflation, so that, with the dramatic decline in the overall demand for labour, they end up paying wages well above the market-clearing rates.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ John Dunlop argued that inter-firm differentials become established as new and prosperous employers pay premium wages to attract new labour in a period of economic growth, which then become embedded in institutionalised wage structures. What we seem to be observing in Russia is essentially the reverse of this process in a period of catastrophic economic decline, in which only the most prosperous employers have been able to continue to maintain real wages at levels corresponding to the traditional norms (Dunlop, 1957).}}}{ There is nothing specifically Russian about this practice. We observed that this is entirely in conformity with sociological and institutionalist analyses of wage determination in the capitalist world, and we noted that it is foreign-owned companies in Russia which pay the highest wages of all. 
\par Despite the high degree of inertia in the level and structure of wages, many employers have taken advantage of their favourable labour market situation and reduced real wages very dramatically, so that by 1996 around a third of all wage-earners earned less than the adult subsistence minimum. This raises the question of why some employers reduce wages, while others do not. How is the balance between \lquote economic\rquote  and \lquote sociological\rquote  considerations in the determination of wages worked out in practice? Our wage regressions suggest that the relative prosperity of the enterprise is one factor in explaining the wages it pays, but our indicators still only explain a small part of wage dispersion. In practice employers enjoy a considerable degree of discretion in their wage determination.
\par Wages in a modern economy are not set through an auction in a marketplace, but on the basis of decisions made by managers in hierarchical social organisations. The decision-making process will involve a variety of considerations and a range of interested parties including, in some cases, representatives of employees. Attempts on the part of management unilaterally to alter the scale or level of pay to the detriment of particular groups or the workforce as a whole generate, at best, resentment and, at worst, overt conflict. In the capitalist countries an entire science of \lquote industrial relations\rquote , later transformed into \lquote human resource management\rquote , developed to find peaceful ways of resolving the conflicts and overcoming the distrust to which attempts to modify the level and structure of pay gave rise. In the Soviet Union, wage reforms were so disruptive that they were constantly postponed (Arnot, 1988; Filtzer, 1994). 
\par Although the most dramatic conflict around wages is that which sets sections of the workforce against the employer, there is also a considerable potential for conflict within the structure of management itself, since different sections of management have different interests corresponding to their different roles. For the finance department, wages may be simply a cost to be minimised in the pursuit of maximum profits, and the accountants may see no reason to pay wages above the lowest rate at which labour can currently be hired in the market. Labour market pressures are more directly transmitted through the personnel department, for which wages are the principal lever of recruitment and retention of employees. Personnel managers may press for an increase in wages if they are losing experienced staff and finding it difficult to fill vacancies with appropriately qualified personnel, and may concur in a reduction in wages if they are being swamped with well-qualified applicants. It is the line managers who are more likely to be the proponents of \lquote efficiency wages\rquote . They will tend to favour high wages which enable them to recruit and retain high quality employees and also provide them with a powerful disciplinary lever and a motivational tool to enable them to meet their performance targets. The dissatisfaction of employees with the level of their remuneration is very likely to be articulated within the structure of management by their line managers, even where there are not any formal channels of employee representation. 
\par The tension between \lquote economic\rquote  and \lquote social\rquote  factors in the determination of wages will be resolved through a process of negotiation between a range of conflicting interests within the management structure. The outcome is likely to depend both on the power and institutional relationships within management and on the scale and character of the external constraints to which the organisation is subject. The typical Russian industrial enterprise still retains the traditional soviet structure of power oriented to the functions of production, in which the management team comprises the enterprise director, chief engineer and shop chiefs, with the economic, financial and personnel departments being regarded as peripheral services.
\par The pattern of change in the structure of wages in Russia is consistent with the supposition that employers follow the line of least resistance and in the first instance adjust their hiring and management practices to a relatively stable level and structure of wages, raising money wages uniformly more or less in line with inflation, although with a lag that is the longer the more hard-pressed is the employer, so that differentials emerge corresponding primarily to the relative prosperity of firms. However, labour is quite mobile in response to wage differentials so lower-wage firms see an increase in quits while the higher-wage employers find large numbers of applicants for vacancies.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ We can tentatively draw some conclusions about workers' priorities from the pattern of change of wage differentials in the Russian recession. First, the fact that the size of differentials between branches has increased while the ranking has changed very little would seem to indicate that workers are more concerned about preserving their position relative to other branches than with the actual size of the differentials. Second, the fact that occupational differentials appear to have changed much less than inter-firm differentials would suggest that people are much more concerned about their pay relative to that of others working in the same workplace than about their pay relative to those working, even in the same occupation, elsewhere.}}}{  The implication of the coexistence of sticky wages and high labour mobility is that there will be \lquote job rationing\rquote  by the more prosperous employers and increased hiring to fill vacancies by the less prosperous. Employers who are in a strong labour market situation will not necessarily take advantage of their situation to reduce real wages, which would lead to discontent within the existing labour force, but instead use their position to strengthen labour discipline and to upgrade the labour force by making increased demands of new employees. Employers who are in a weaker financial situation will not be in a position to raise wages to compensate for inflation and so may have to accept a deterioration of labour discipline and in the quality of the labour force, while they may try to compensate for labour shortages by intensifying the labour of those who remain.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ }{\lang2057 Thurow has recently noted in relation to the US labour market that \lquote the actual short-run clearing mechanism is a rapid upward or downward adjustment in hiring credentials in response to the tightness of labour markets\rquote  so that \lquote the short-run adjustment process is best seen as a job-filtering system\rquote  (Thurow, 1998, pp. 32\endash 3). This picture, noted long ago in the capitalist world (Rees, 1966), corresponds very closely to that which we find in the employment policies of Russian enterprises and the corresponding labour market behaviour of Russian workers in transition (}{Clarke, 1999}{\lang2057 ).}}}{ 
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {If the employer finds that profitability is coming under pressure, the first response is more likely to be to try to reorganise production and increase productivity in order to economise on labour, rather than provoking conflict by cutting wages. If employees do not respond, their failure to raise productivity can be used as a legitimation of wage cuts. Falling sales and declining employment may provide a very strong incentive and ample opportunity for management to reduce the level of wages, particularly where this can be achieved by postponing money wage increases to compensate for inflation. The cost of such a wage strategy is likely to be a deterioration of the morale and commitment of the labour force, an increase in labour turnover, absenteeism and industrial conflict, a deterioration of labour discipline and a fall in productivity and product quality. However, a reduction in pay is likely to breed much less immediate resentment if the workers are convinced of the firm\rquote s inability to pay than if it is associated with increasing managerial salaries and rising profits, so we would expect the less prosperous enterprises to be the more likely to take advantage of a more favourable labour market situation to hold down wages and the more prosperous to preserve the established level and structure of wages regardless of the labour market situation. 
\par This process may lead to a feedback from relative wages to productivity and profitability that can lead to the reproduction of a stable system of wage and productivity differentials between firms. If the wage paid is relatively high, then there will be few quits, there will be a job queue and employers will be much more selective in their hiring. This in turn will reduce the costs of labour turnover and raise the quality and motivation of the workforce whose increased productivity will, at least to some extent, legitimate the payment of higher wages. If the wage paid is relatively low, the employer will incur larger costs of job search, will face higher labour turnover and will suffer from deteriorating labour discipline, all of which will lead to falling productivity in line with falling wages. All of this is what we see in the real world of management practice, confirmed by innumerable case studies conducted around the world over the years, and it looks very much as though this is what we see in the Russian case.
\par Of course, different interpretations of the functioning of the labour market are by no means only of theoretical interest. The policy implications are equally fundamental. If wages are attached to individuals, policy should focus on increasing the earning power of individuals by investing in education and training, the consequent increase in potential labour productivity stimulating private job-creating investment. If wages are attached to jobs, policy should focus on investment in the generation of high quality jobs, supplemented by investment in education and training to avoid skill bottlenecks. In Russia, where fixed investment has fallen by three-quarters, 95% of industrial plant and equipment dates back to the pre-reform period, enrolments in higher education have steadily increased, three-quarters of the unemployed have some professional or technical education and fewer than 20% are unskilled (Goskomstat, 1999b; Goskomstat, 1999a), the priority should be clear.
\par }\pard\plain \s1\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\f1\fs28\lang2057\kerning28\cgrid {References
