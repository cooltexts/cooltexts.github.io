rt\brdrs\brdrw15\brdrcf16 \clbrdrb\brdrs\brdrw30\brdrcf16 \cltxlrtb \cellx2598\clvertalt\clbrdrt\brdrs\brdrw15\brdrcf16 \clbrdrb\brdrs\brdrw30\brdrcf16 \cltxlrtb \cellx3686\clvertalt\clbrdrt\brdrs\brdrw15\brdrcf16 \clbrdrl\brdrs\brdrw15\brdrcf15 \clbrdrb\brdrs\brdrw30\brdrcf16 \cltxlrtb \cellx5076\clvertalt\clbrdrt\brdrs\brdrw15\brdrcf16 \clbrdrb\brdrs\brdrw30\brdrcf16 \clbrdrr\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6516\clvertalt\clbrdrt\brdrs\brdrw15\brdrcf16 \clbrdrb\brdrs\brdrw30\brdrcf16 \cltxlrtb \cellx7347\pard\plain \s23\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {ISITO\cell 1998\cell }\pard \s23\qr\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright {0.24\cell }\pard \s23\qr\ri113\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright {0.24\cell }\pard \s23\qc\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright {51\cell 45\cell }\pard \s23\qr\sb60\sa60\sl240\slmult0\nowidctlpar\intbl\adjustright {2037\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\pard\plain \s15\sb120\sa120\nowidctlpar\widctlpar\adjustright \i\lang2057\cgrid {{\*\bkmkstart _Ref456453884}{\*\bkmkstart _Toc456753733}
\par \page Table {\*\bkmkend _Ref456453884}3: Percentage decomposition of wage inequality within each city, ISITO survey, April/May 1998{\*\bkmkend _Toc456753733}
\par }\trowd \trgaph30\trrh250\trleft-30 \clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx1276\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx2522\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx4097\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx5672\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6818\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx7401\pard\plain \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {\cell MLD within city\cell % of MLD within occupation and branch\cell % of MLD between occupations within branch\cell % of MLD between branches\cell N\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\trowd \trgaph30\trrh250\trleft-30 \clvertalt\cltxlrtb \cellx1276\clvertalt\cltxlrtb \cellx2522\clvertalt\cltxlrtb \cellx4097\clvertalt\cltxlrtb \cellx5672\clvertalt\cltxlrtb \cellx6818\clvertalt\cltxlrtb \cellx7401\pard\plain \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {Samara\cell 0.18\cell 51\cell 30\cell 19\cell 529\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\pard\plain \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {Kemerovo\cell 0.28\cell 45\cell 22\cell 33\cell 154\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\pard\plain \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {Lyubertsy\cell }\pard \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright {0.24\cell 41\cell 28\cell 31\cell 271\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\trowd \trgaph30\trrh250\trleft-30 \clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx1276\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx2522\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx4097\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx5672\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx6818\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx7401\pard\plain \s23\sb60\sl240\slmult0\nowidctlpar\intbl\adjustright \fs26\lang2057\kerning20\cgrid {Syktyvkar\cell 0.19\cell 52\cell 32\cell 15\cell 194\cell }\pard\plain \nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\row }\pard \qj\sb120\nowidctlpar\adjustright {Given that the dispersion of wages is pretty uniform across occupations, it would seem more likely that it reflects differences in the wage paid between establishments, rather than differences paid to different individuals at different points on the wage ladder within individual firms. Unfortunately we do not have a data set which allows us to decompose individual wage inequality within and between individual firms. However, the Russian Labour Flexibility Survey collects firm-level data on average wages and the average wage of eight occupational gradings (managers, specialists and clerical workers at enterprise and shop levels, skilled and unskilled manual workers) for a sample of industrial enterprises. The relevant dispersion indices for average wages between enterprises and for the dispersion of wages within the enterprise are summarised in Table 4 (the first column relates to the panel of 145 enterprises surveyed in all four years). As can be seen from the first and third columns, the dispersion of wages between enterprises, even within branches and oblasts, is substantial, accounting for about half the total dispersion of wages at the individual level suggested by the sources cited above. By contrast, the dispersion of wages between occupational categories within the enterprise accounts for only a very small proportion of the total dispersion of wages.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ I am very grateful to the Centre for Labour Market Studies of the Institute of Economics of the Academy of Sciences for making this data available to me. Those enterprises which reported that they had not paid wages the previous month are excluded, but some enterprises will have paid only a portion of the wages due. The increasing incidence of non-payment will account for at least part of the increase in reported dispersion between 1994 and 1997. The MLD of wages of occupational groups within the enterprise is the MLD of the average wage of each of the groups, weighted by the number in each category.}}}{ Dispersion indices for official Goskomstat enterprise-level average wage data for four regions for 1996 is given in the final rows (branches are industry, trade and construction).}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ This data includes a number of enterprises which report very high or very low wages, although the average monthly wage reported in this case is supposed to be the \lquote accounting wage\rquote , i.e. the wage which should be paid, whether or not it actually is paid, so the data should not be affected by non-payment. There is no obvious explanation for these discrepancies (Luke and Schaffer, 2000). In the final row, in calculating the MLD I have excluded all enterprises which report paying an average wage below 150,000 (just over twice the legal minimum wage) or over 3,500,000 roubles a month (about the highest average recorded in the corresponding RLFS data set). I am grateful to Vladimir Gimpel\rquote son for making this data available to me.}}}{ Although this data is rather unsatisfactory, it shows a wage dispersion of the same order of magnitude as the much smaller RLFS data set.
\par }\pard\plain \s15\sb120\sa120\nowidctlpar\adjustright \i\lang2057\cgrid {\page Table 4: Decomposition of wage inequality between enterprises, RLFS data, 1994-7, Goskomstat regional data 1996
\par }\trowd \trgaph108\trleft-108 \clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx591\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx1660\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx3410\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx4693\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx5924\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx6930\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx7938\clvertalt\clbrdrt\brdrs\brdrw30\brdrcf15 \clbrdrb\brdrs\brdrw15\brdrcf15 \cltxlrtb \cellx8647\pard\plain \qj\sb120\nowidctlpar\intbl\adjustright \lang2057\cgrid {\fs20 \cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {\fs20 MLD between enterprises within branch and within oblast (same set of 145)\cell MLD between enterprises\cell CV between enterprises\cell }\pard \sb120\nowidctlpar\intbl\adjustright {\fs20 MLD between enterprises within branch and within oblast\cell CV between enterprises within branch and within oblast\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {\fs20 Average MLD between occupational groups within enterprise\cell N\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs20 \row }\trowd \trgaph108\trleft-108 \clvertalt\cltxlrtb \cellx591\clvertalt\cltxlrtb \cellx1660\clvertalt\cltxlrtb \cellx3410\clvertalt\cltxlrtb \cellx4693\clvertalt\cltxlrtb \cellx5924\clvertalt\cltxlrtb \cellx6930\clvertalt\cltxlrtb \cellx7938\clvertalt\cltxlrtb \cellx8647\pard \qj\sb120\nowidctlpar\intbl\adjustright {1994\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.087\cell .125\cell .53\cell .085\cell .42\cell .006\cell 367\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\row }\pard \qj\sb120\nowidctlpar\intbl\adjustright {1995\cell .094\cell .137\cell .59\cell .096\cell .45\cell .007\cell 448\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\row }\pard \qj\sb120\nowidctlpar\intbl\adjustright {1996\cell .125\cell .191\cell .63\cell .134\cell .48\cell .007\cell 468\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\row }\pard \qj\sb120\nowidctlpar\intbl\adjustright {1997\cell .141\cell .200\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.70\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.133\cell .52\cell .009\cell 179\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\row }\pard \qj\sb120\nowidctlpar\intbl\adjustright {1996\cell }{\fs20 Goskomstat data\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.235\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.72\cell .199\cell .63\cell \cell 6304\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\row }\trowd \trgaph108\trleft-108 \clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx591\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx1660\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx3410\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx4693\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx5924\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx6930\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx7938\clvertalt\clbrdrb\brdrs\brdrw30\brdrcf15 \cltxlrtb \cellx8647\pard \qj\sb120\nowidctlpar\intbl\adjustright {1996\cell }{\fs20 Goskomstat without outliers\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.186\cell }\pard \qj\sb120\nowidctlpar\intbl\adjustright {.64\cell .158\cell .57\cell \cell 6066\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\row }\pard\plain \s26\qj\fi-709\li709\sb60\sa120\sl240\slmult0\nowidctlpar\adjustright \i\fs22\lang2057\kerning20\cgrid {Source: Author\rquote s calculations from RLFS survey data and Goskomstat data, excluding zero reported wage.
\par }\pard\plain \s2\qj\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\i\f1\lang2057\cgrid {The determinants of pay differentials
\par }\pard\plain \qj\sb120\nowidctlpar\widctlpar\adjustright \lang2057\cgrid {Substantial wage differences within occupations are perfectly compatible with competitive labour market theory, according to which individuals with more skill, ability and experience can earn more at a particular job because they are more productive. In this case the explanation for our findings so far would be that more successful enterprises have been able to pay higher wages and attract the more highly skilled and so more productive employees to justify paying those higher wages. The final question that we have to address, therefore, is to what extent is wage differentiation within occupations, within local labour markets, based on differences in individual skill, experience and capacity and to what extent does it express differences in the willingness and ability of employers to pay higher wages? The two are by no means mutually exclusive, since the employer who pays higher wages can pursue more selective hiring and firing policies so as to end up with the better qualified employees, but if we find that there is little relation between relative pay and individual capacities then the presumption must be that pay differentials are institutionally embedded rather than being determined in the labour market. 
\par The measuring of individual capacities, whether from the point of view of personnel selection or econometric analysis, is notoriously difficult. We have already noted that research on wage determination in Russia finds that \lquote human capital\rquote  variables explain very little of the variation in wages, a standard Mincerian quadratic regression explaining only 4% of the variation in hourly wages across Russia in the 1994 RLMS data (Grogan, 1997, p. 7), 7.5% in the 1998 RLMS data or 11% in the ISITO data (with regional controls, my calculations), with only a small return to years of education and rather larger (though diminishing) returns to experience. This observation may be reconciled with competitive labour market theory by postulating that formal educational qualifications and soviet work experience are particularly poor indicators of the true value of human capital in post-soviet Russia (Brainerd, 1998), but since these are the only indicators available to prospective employers (who do not usually use any forms of testing or solicit testimonials in making appointments) then we would expect them to be the factors effective in determining labour market outcomes, at least for the recently appointed.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ A Mincerian regression is as poor for recent appointees as it is for those with longer tenure. It is also no better for those, such as managers and professionals, who are paid according to fixed salary scales, than it is for those such as skilled manual workers who are paid by results.}}}{ There may well be unobserved heterogeneity between employees, but if so, this is unobserved both by the econometrician and by the employer. If the employer cannot observe it, then he cannot reward it.
\par Using the ISITO survey data, we can take the investigation a little further by distinguishing analytically between those factors which explain wage differentials within occupations and those factors which explain differentials between occupations. We can get some indication of the relative weight of these factors by running a multi-level regression (using the MLwiN software), which prepares maximum likelihood estimates of the coefficients and standard errors of a regression which includes error terms defined at these distinct levels. The results of such a regression for all occupations in which there is more than one individual in the relevant city are summarised in Table Four. 
\par Within this dataset, 71% of the variance in wages is within occupations, 27% is between occupations and only 2% is between cities, the latter being accommodated by relevant dummy variables. We can get some idea of the contribution of the various explanatory variables to the explanation of the variance of wages by comparing the residuals of the regression with and without the relevant set of variables. With the full set of explanatory variables, 83% of the variance between occupations, but only 18% of the variance within occupations, is explained.
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {On this basis we find that the \lquote human capital\rquote  variables account for only 4% of the variance within occupations and 5% of the variance between occupations (age and experience account for 3% of the variance within and 2% of the variance between occupations, education accounts for only 1% of the variance within and 3% of the variance between occupations).}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ We achieve very similar results running a similar regression with the 1998 RLMS data, where we find that age and experience explain 2% of the variance within and 3% of the variance between occupations, education and training accounts for 2% of the variance within and 4% of the variance between occupations, the same as is accounted for by sex. Socio-economic status accounts for 17% of the variance between occupations in the RLMS data. The coefficients in the RLMS regression are very close to those with the ISITO data. The only significant difference is that in the RLMS data those who have taken their jobs since 1992 do not earn less than those who have been in their jobs for longer and unskilled workers and junior specialists earn significantly less than in the ISITO data.}}}{ The young earn significantly less than prime age adults, but the benefits of experience fade from the mid-40s and those approaching retirement, the most experienced workers of all, earn barely more than do teenagers, particularly if they have had to change jobs since the beginning of reform. Those with technical or higher education earn significantly more than those with secondary education or less. These \lquote human capital\rquote  variables account for much less of the variance in wages between occupations than does the socio-economic status of the occupation, which on its own accounts for a further 11% of the variance of wages between occupations.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ Of course, socio-economic status is correlated with education. If we do not control for socio-economic status, education and training accounts for just over a fifth of the variance in wages between occupations. Similarly, men tend to predominate in higher status occupations and higher paying sectors of the economy (in the ISITO sample women account for 85% of junior white collar workers and almost three-quarters of all employees in the budget sector, while men account for over 60% of managers and over 80% of skilled workers). Composite variables (the proportion of men and the proportion with further and higher education in each occupation) have a positive impact on the wage which ceases to be statistically significant once socio-economic status and sector are controlled for. Comparison of occupational differentiation over time is difficult because the standard errors are large and we have little comparable data for the pre-reform period. However, comparing the coefficients with those derived by Katz, 1997 from data of a Taganrog survey in 1989 suggests that there has been a sharp relative decline in the wages of unskilled clerical, service and manual workers.}}}{ They also account for little more of the variance in wages than does the ascriptive factor of sex, which accounts for 3% of the variance within occupations and 4% of the variance between occupations, controlling for all other variables.}{\cs20\fs20\super \chftn {\footnote \pard\plain \s19\qj\sb120\nowidctlpar\adjustright \fs20\cgrid {\cs20\super \chftn }{ The variance is such that sex is not statistically significant at the occupational level. Adding dummies for all male and all female occupations has no effect. Recent analyses have suggested that a substantial portion of the gender difference in wages in Russia can be explained by occupational differences (Newell and Reilly, 1996; Reilly, 1999), but this regression suggests that these differences in occupational wages reflect the balance of the sexes in particular occupations, so that, other things being equal, men working in \lquote women\rquote s occupations\rquote  are not paid significantly less than men working in \lquote men\rquote s occupations\rquote , and conversely for women.}}}{ 
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {The most powerful determinants of relative wages are the set of dummy variables that reflect characteristics of the enterprise (sector, enterprise size, experience of administrative leave, respondent\rquote s evaluation of relative stability and relative pay and whether the respondent took a pay increase or cut when taking the job). These dummies together account for 12% of the variance within occupations and 14% of the variance between occupations: 8% of the variance between occupations is accounted for by the sectoral dummies and 8% of the variance within occupations by the enterprise-level indicators. Small enterprises pay less, as does the budget sector, while new private enterprises pay wages above the average. We have only fragmentary data on firm-specific variables. Experience of wage delays, redundancies, and payment in kind, either for the respondent or for the enterprise (not shown here), are not significant indicators of the relative wage, but those enterprises with a recent history of administrative leave, which is the most reliable indicator of an enterprise in economic difficulties, pay significantly less than those without. Those employers which respondents say pay less than similar enterprises in fact appear to do so, as do those which respondents describe as being less stable. Those who say that they took a cut or an increase in pay when taking their present job do in fact earn significantly less or more than the average wage (although the effect tends to be slightly weaker the longer ago they took the job, it remains significant and almost as strong even if they took the job before the beginning of reform, suggesting that the pay hierarchy of enterprises is reasonably stable).
\par It seems that conventional indicators of human capital explain only a very small portion of wage differentiation. Of course, it might always be the case that these indicators do not capture the individual qualities that make up \lquote human capital\rquote , but the fact that the dispersion of wages is similar across all occupational categories, from managers and professionals, through technicians and skilled workers to the unskilled, is much more consistent with the hypothesis that differentiation derives primarily from institutional determinants and reflects only to a very limited degree differences in \lquote human capital\rquote . It is conceivable that the best-paid head of a production division in Samara is seventeen times as productive as the worst-paid, but is it likely that the best-paid loader is able to load ten times as much, or the best-paid cleaner to clean twenty times as much, as the worst-paid? It seems much more likely that the heterogeneity is predominantly between employers rather than between employees.
\par }\pard \qj\sb120\nowidctlpar\adjustright {
\par }\pard \sb120\nowidctlpar\widctlpar\adjustright {
\par }\pard \qj\sb120\nowidctlpar\widctlpar\adjustright {
\par }\pard\plain \s18\qj\sb120\nowidctlpar\widctlpar\adjustright \i\lang2057\cgrid {\f1 \page }{\fs22 Table 4 Multi-level Regression. Dependent Variable: Log of normal hourly wage. Levels: individual, four-digit occupation, city. ISITO survey. All cases in which there is more than one individual in the occupation in the city.}{\f1\fs22 
\par }\trowd \clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx5103\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx6352\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx7558\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \cltxlrtb \cellx8669\pard\plain \qc\sb120\nowidctlpar\widctlpar\intbl\adjustright \lang2057\cgrid {\fs22  \cell }\pard \qr\sb120\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 Sample Means\cell }\pard \qc\sb120\nowidctlpar\widctlpar\intbl\adjustright {\field{\*\fldinst {\fs22 symbol 98 \\f "Symbol" \\s 11}}{\fldrslt {\f3\fs22 b}}}{\fs22 \cell Std. Error\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \clvertalt\cltxlrtb \cellx5103\clvertalt\cltxlrtb \cellx6352\clvertalt\cltxlrtb \cellx7558\clvertalt\cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Constant\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 1.550\cell 0.817\cell 0.121\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx8669\pard \qc\nowidctlpar\widctlpar\intbl\adjustright {\b\i\fs22 Individual- level variables}{\b\i\f17\fs22\cf1 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\trowd \trkeep \clvertalt\cltxlrtb \cellx5103\clvertalt\cltxlrtb \cellx6352\clvertalt\cltxlrtb \cellx7558\clvertalt\cltxlrtb \cellx8669\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Age (years)\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 40.25\cell 0.044\cell 0.005\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 \row }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs22 Age squared /100\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 17.63\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 -0.055\cell }\pard \qr\nowidctlpar\widctlpar\intbl\adjustright {\f17\fs22\cf1 0.006\cell }\pard \nowidctlpar\widc