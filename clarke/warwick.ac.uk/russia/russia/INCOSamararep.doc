\'f0\'e8\'f5\'ee\'e4\'e8\'f2\'f1\'ff \'ed\'e0 \'ee\'f2\'f0\'e0\'f1\'eb\'e8 \'ec\'e0\'f8\'e8\'ed\'ee\'f1\'f2\'f0\'ee\'e5\'ed\'e8\'ff (16 \'ef\'f0\'e5\'e4\'ef\'f0\'e8\'ff\'f2\'e8\'e9) \'e8 \'ef\'e8\'f9\'e5\'e2\'ee\'e9 \'ef\'f0\'ee\'ec\'fb\'f8\'eb\'e5\'ed
\'ed\'ee\'f1\'f2\'e8 (13).
\par }\pard\plain \qj\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\lang1049\cgrid {\fs24 
\par }{\f17\fs24 \'cf\'f0\'e5\'ee\'e1\'eb\'e0\'e4\'e0\'fe\'f2  \'ea\'f0\'f3\'ef\'ed\'fb\'e5 \'ef\'f0\'e5\'e4\'ef\'f0\'e8\'ff\'f2\'e8\'ff \'f1\'ee \'f1\'f0\'e5\'e4\'ed\'e5\'f1\'ef\'e8\'f1\'ee\'f7\'ed\'ee\'e9 \'f7\'e8\'f1\'eb\'e5\'ed\'ed\'ee\'f1\'f2\'fc\'fe \'f0
\'e0\'e1\'ee\'f2\'ed\'e8\'ea\'ee\'e2 \'f2\'fb\'f1\'ff\'f7\'e0 \'e8 \'e1\'ee\'eb\'e5\'e5 \'f7\'e5\'eb\'ee\'e2\'e5\'ea, \'e8 \'f1\'f0\'e5\'e4\'ed\'e8\'e5, \'f1\'ee \'f1\'f0\'e5\'e4\'ed\'e5\'f1\'ef\'e8\'f1\'ee\'f7\'ed\'ee\'e9 \'f7\'e8\'f1\'eb\'e5\'ed\'ed\'ee
\'f1\'f2\'fc\'fe \'e4\'ee 500 \'f7\'e5\'eb\'ee\'e2\'e5\'ea, \'ea\'ee\'f2\'ee\'f0\'fb\'e5 \'f1\'ee\'f1\'f2\'e0\'e2\'e8\'eb\'e8 54% \'ee\'f2 \'e2\'f1\'e5\'f5 \'e8\'ed\'ed\'ee\'e2\'e0\'f6\'e8\'ee\'ed\'ed\'ee-\'e0\'ea\'f2\'e8\'e2\'ed\'fb\'f5 \'ef\'f0\'e5\'e4
\'ef\'f0\'e8\'ff\'f2\'e8\'e9.
\par }{\fs24 
\par }{\f17\fs24 \'c7\'e0\'f2\'f0\'e0\'f2\'fb \'ed\'e0 \'f2\'e5\'f5\'ed\'ee\'eb\'ee\'e3\'e8\'f7\'e5\'f1\'ea\'e8\'e5 \'e8\'ed\'ed\'ee\'e2\'e0\'f6\'e8\'e8 \'f1\'ee\'f1\'f2\'e0\'e2\'e8\'eb\'e8 1153,8 \'ec\'eb\'f0\'e4. \'f0\'f3\'e1., \'e2 \'f2\'ee\'ec \'f7\'e8\'f1
\'eb\'e5 \'f2\'e5\'ea\'f3\'f9\'e8\'e5 \'e7\'e0\'f2\'f0\'e0\'f2\'fb \endash  18%, \'ea\'e0\'ef\'e8\'f2\'e0\'eb\'fc\'ed\'fb\'e5 \'e7\'e0\'f2\'f0\'e0\'f2\'fb -  77%.  
\par }{\fs24 
\par }{\f17\fs24 \'d2\'e5\'ea\'f3\'f9\'e8\'e5 \'e7\'e0\'f2\'f0\'e0\'f2\'fb, \'e2 \'ee\'f1\'ed\'ee\'e2\'ed\'ee\'ec, \'e1\'fb\'eb\'e8 \'ed\'e0\'ef\'f0\'e0\'e2\'eb\'e5\'ed\'fb \'ed\'e0 \'f2\'e5\'f5\'ed\'ee\'eb\'ee\'e3\'e8\'f7\'e5\'f1\'ea\'f3\'fe \'ef\'ee\'e4\'e3
\'ee\'f2\'ee\'e2\'ea\'f3 \'ef\'f0\'ee\'e8\'e7\'e2\'ee\'e4\'f1\'f2\'e2\'e0, \'ef\'f0\'ee\'e1\'ed\'ee\'e5 \'ef\'f0\'ee\'e8\'e7\'e2\'ee\'e4\'f1\'f2\'e2\'ee \'e8 \'e8\'f1\'ef\'fb\'f2\'e0\'ed\'e8\'ff (45%), \'e8\'f1\'f1\'eb\'e5\'e4\'ee\'e2\'e0\'ed\'e8\'ff \'e8
 \'f0\'e0\'e7\'f0\'e0\'e1\'ee\'f2\'ea\'e8 (43%), \'ef\'f0\'ee\'e5\'ea\'f2\'ed\'ee-\'ea\'ee\'ed\'f1\'f2\'f0\'f3\'ea\'f2\'ee\'f0\'f1\'ea\'e8\'e5 \'f0\'e0\'e1\'ee\'f2\'fb, \'f1\'e2\'ff\'e7\'e0\'ed\'ed\'fb\'e5 \'f1 \'f2\'e5\'f5\'ed\'ee\'eb\'ee\'e3\'e8\'f7\'e5
\'f1\'ea\'e8\'ec \'ee\'f1\'ed\'e0\'f9\'e5\'ed\'e8\'e5\'ec \'ef\'f0\'ee\'e8\'e7\'e2\'ee\'e4\'f1\'f2\'e2\'e0 \'e8 \'ed\'e0\'f7\'e0\'eb\'fc\'ed\'fb\'ec \'fd\'f2\'e0\'ef\'ee\'ec \'e2\'fb\'ef\'f3\'f1\'ea\'e0 \'ef\'f0\'ee\'e4\'f3\'ea\'f6\'e8\'e8 (2,5%). \'cd
\'e0 \'ef\'f0\'e8\'ee\'e1\'f0\'e5\'f2\'e5\'ed\'e8\'e5 \'ef\'f0\'e0\'e2 \'ed\'e0 \'ef\'f0\'ee\'ec\'fb\'f8\'eb\'e5\'ed\'ed\'f3\'fe \'f1\'ee\'e1\'f1\'f2\'e2\'e5\'ed\'ed\'ee\'f1\'f2\'fc, \'e1\'e5\'f1\'ef\'e0\'f2\'e5\'ed\'f2\'ed\'fb\'e5 \'eb\'e8\'f6\'e5\'ed
\'e7\'e8\'e8, \'ed\'ee\'f3-\'f5\'e0\'f3 \'e8 \'e4\'f0\'f3\'e3\'e8\'e5 \'ee\'e1\'fa\'e5\'ea\'f2\'fb \'e8\'ed\'f2\'e5\'eb\'eb\'e5\'ea\'f2\'f3\'e0\'eb\'fc\'ed\'ee\'e9 \'f1\'ee\'e1\'f1\'f2\'e2\'e5\'ed\'ed\'ee\'f1\'f2\'e8 \endash  1% \'e2\'f1\'e5\'f5 \'f2\'e5
\'ea\'f3\'f9\'e8\'f5 \'e7\'e0\'f2\'f0\'e0\'f2. \'cd\'e0 \'ee\'e1\'f3\'f7\'e5\'ed\'e8\'e5, \'ef\'ee\'e4\'e3\'ee\'f2\'ee\'e2\'ea\'f3 \'e8 \'ef\'e5\'f0\'e5\'ea\'e2\'e0\'eb\'e8\'f4\'e8\'ea\'e0\'f6\'e8\'fe \'ef\'e5\'f0\'f1\'ee\'ed\'e0\'eb\'e0 \'e2 \'f1\'e2\'ff
\'e7\'e8 \'f1 \'e2\'ed\'e5\'e4\'f0\'e5\'ed\'e8\'e5\'ec \'f2\'e5\'f5\'ed\'ee\'eb\'ee\'e3\'e8\'f7\'e5\'f1\'ea\'e8\'f5 \'e8\'ed\'ed\'ee\'e2\'e0\'f6\'e8\'e9 \endash  0,2%, \'ec\'e0\'f0\'ea\'e5\'f2\'e8\'ed\'e3\'ee\'e2\'fb\'e5 \'e8\'f1\'f1\'eb\'e5\'e4\'ee\'e2
\'e0\'ed\'e8\'ff \endash  0,2%.
