\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew10\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr0\dpfillbgcg0\dpfillbgcb255\dpfillpat1}}{\b\i 1 \tab I
