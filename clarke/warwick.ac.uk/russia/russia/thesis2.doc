\par }{\lang1024 {\*\do\dobxcolumn\dobypara\dodhgt8217\dpline\dpptx0\dppty0\dpptx8209\dppty1\dpx216\dpy10\dpxsize8209\dpysize1\dplinesolid\dplinecor255\dplinecog0\dplinecob0\dplinew10}}{\b\i 
\par }{\lang1024 {\*\do\dobxcolumn\dobypara\dodhgt8299\dprect\dpx3240\dpy149\dpxsize289\dpysize1153\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr0\dpfillbgcg0\dpfillbgcb255\dpfillpat1}
{\*\do\dobxcolumn\dobypara\dodhgt8283\dprect\dpx1368\dpy149\dpxsize289\dpysize1153\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr0\dpfillbgcg0\dpfillbgcb255\dpfillpat1}
