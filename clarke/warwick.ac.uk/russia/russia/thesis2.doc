\par }{\lang1024 {\*\do\dobxcolumn\dobypara\dodhgt8264\dptxbx\dptxbxmar0{\dptxbxtext \pard\plain \qc\sa120\sl480\slmult1\widctlpar \f40\lang2057 Security
