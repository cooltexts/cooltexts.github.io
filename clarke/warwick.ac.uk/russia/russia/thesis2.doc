\cell }\pard \s34\qj\widctlpar\intbl\pvpara\posy0\dxfrtext180\dfrmtxtx180\dfrmtxty0 88.3{\f133 \cell }\pard \s34\qj\widctlpar\intbl\pvpara\posy0\dxfrtext180\dfrmtxtx180\dfrmtxty0 74{\f133 \cell }\pard 
