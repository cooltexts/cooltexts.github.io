\par }}\dpx2520\dpy144\dpxsize2161\dpysize577\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr255\dpfillbgcg255\dpfillbgcb255\dpfillpat1}}
