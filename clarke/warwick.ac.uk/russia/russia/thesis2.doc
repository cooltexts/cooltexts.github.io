\par }{\lang1024 {\*\do\dobxcolumn\dobypara\dodhgt8325\dprect\dpx4968\dpy140\dpxsize289\dpysize577\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr0\dpfillbgcg0\dpfillbgcb255\dpfillpat1}
