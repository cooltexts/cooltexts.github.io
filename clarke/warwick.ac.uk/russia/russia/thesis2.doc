\par }{\lang1024 {\*\do\dobxcolumn\dobypara\dodhgt8292\dprect\dpx1944\dpy159\dpxsize289\dpysize1729\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr0\dpfillbgcg0\dpfillbgcb255\dpfillpat1}
