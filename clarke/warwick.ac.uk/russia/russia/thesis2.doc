\dpx-72\dpy250\dpxsize433\dpysize433\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr25\dpfillbgcg25\dpfillbgcb25\dpfillpat1}}
