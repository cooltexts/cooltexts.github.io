\par }\pard \qj\widctlpar\intbl {\b\fs16 Kukino }{\fs16  area -1\cell }\pard \qj\widctlpar\intbl {\fs16 \cell }\pard \qj\widctlpar\intbl {\fs16 Dept. of Social
