{\*\do\dobxcolumn\dobypara\dodhgt8408\dpline\dpptx0\dppty0\dpptx2449\dppty1\dpx3168\dpy54\dpxsize2449\dpysize1\dplinesolid\dplinecor0\dplinecog0\dplinecob0\dplinew20}}{\fs16 \tab \tab 
