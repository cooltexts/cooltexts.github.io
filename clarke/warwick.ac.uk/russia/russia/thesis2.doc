0004000000f0010300050000000102000000000e00000024030500d7069f1171089f117108a703d706a703d7069f110e000000240305000a0a7e12a40b7e12a40ba7030a0aa7030a0a7e120e000000240305003e0d3d14d80e3d14d80ea7033e0da7033e0d3d140e0000002403050071101d150b121d150b12a7037110a703
71101d150e00000024030500a51304083f1504083f15a703a513a703a51304080e00000024030500d8161d1572181d157218a703d816a703d8161d150e000000240305000b1a9f11a51b9f11a51ba7030b1aa7030b1a9f110e000000240305003f1d9f11d91e9f11d91ea7033f1da7033f1d9f1108000000fa020000000000
0000000000040000002d01030007000000fc020000ffffff000000040000002d010500040000002d010100040000002701ffff030000001e00040000002d010000040000002d010400040000002d01020005000000010200000000050000000902ffffff000700000016049d03481f2015a105040000002d01030004000000
