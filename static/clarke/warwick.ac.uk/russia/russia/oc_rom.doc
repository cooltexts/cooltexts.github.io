{\rtf1\ansi\ansicpg1251\uc1 \deff0\deflang1033\deflangfe1033{\fonttbl{\f0\froman\fcharset0\fprq2{\*\panose 02020603050405020304}Times New Roman;}{\f1\fswiss\fcharset0\fprq2{\*\panose 020b0604020202020204}Arial;}{\f3\froman\fcharset2\fprq2{\*\panose 05050102010706020507}Symbol;}{\f16\froman\fcharset204\fprq2{\*\panose 02020603050405020304}Times New Roman Cyr{\*\falt Times New Roman};}{\f17\froman\fcharset238\fprq2 Times New Roman CE;}{\f18\froman\fcharset204\fprq2 Times New Roman Cyr;}{\f20\froman\fcharset161\fprq2 Times New Roman Greek;}{\f21\froman\fcharset162\fprq2 Times New Roman Tur;}{\f22\froman\fcharset186\fprq2 Times New Roman Baltic;}{\f23\fswiss\fcharset238\fprq2 Arial CE;}{\f24\fswiss\fcharset204\fprq2 Arial Cyr;}{\f26\fswiss\fcharset161\fprq2 Arial Greek;}{\f27\fswiss\fcharset162\fprq2 Arial Tur;}{\f28\fswiss\fcharset186\fprq2 Arial Baltic;}}{\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;\red255\green0\blue255;\red255\green0\blue0;\red255\green255\blue0;\red255\green255\blue255;\red0\green0\blue128;\red0\green128\blue128;\red0\green128\blue0;\red128\green0\blue128;\red128\green0\blue0;\red128\green128\blue0;\red128\green128\blue128;\red192\green192\blue192;}{\stylesheet{\nowidctlpar\widctlpar\adjustright \fs20\cgrid \snext0 Normal;}{\*\cs10 \additive Default Paragraph Font;}{\s15\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid \snext15 Обычный;}{\s16\sb240\sa60\keepn\nowidctlpar\widctlpar\adjustright \b\f1\fs28\lang1049\kerning28\cgrid \sbasedon15 \snext15 заголовок 1;}{\s17\keepn\nowidctlpar\widctlpar\adjustright \b\f16\lang1049\cgrid \sbasedon15 \snext15 заголовок 2;}{\s18\sb240\sa60\keepn\nowidctlpar\widctlpar\adjustright \f1\lang1049\cgrid \sbasedon15 \snext15 заголовок 3;}{\*\cs19 \additive Основной шрифт;}{\s20\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid \sbasedon15 \snext20 Основной текст;}{\s21\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid \sbasedon15 \snext21 Основной текст 2;}{\s22\qj\fi708\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid \sbasedon15 \snext22 Основной текст 21;}{\s23\nowidctlpar\widctlpar\adjustright \b\f16\lang1049\cgrid \sbasedon15 \snext23 Основной текст 3;}{\s24\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid \sbasedon15 \snext24 текст сноски;}}{\*\listtable{\list\listtemplateid68747279\listsimple{\listlevel\levelnfc0\leveljc0\levelfollow0\levelstartat1\levelspace0\levelindent0{\leveltext\'02\'00.;}{\levelnumbers\'01;}\fi-360\li360\jclisttab\tx360 }{\listname ;}\listid452989558}{\list\listtemplateid68747265\listsimple{\listlevel\levelnfc23\leveljc0\levelfollow0\levelstartat1\levelspace0\levelindent0{\leveltext\'01\u-3913 ?;}{\levelnumbers;}\f3\fbias0 \fi-360\li360\jclisttab\tx360 }{\listname ;}\listid1564440403}}{\*\listoverridetable{\listoverride\listid452989558\listoverridecount0\ls1}{\listoverride\listid1564440403\listoverridecount0\ls2}}{\info{\title Мансуров В.А. ИТР конверсируемых предприятий: проблемы социальной адаптации}{\author Павел Романов}{\operator Kozina}{\creatim\yr1998\mo9\dy14\hr11\min39}{\revtim\yr1998\mo9\dy14\hr11\min39}{\version2}{\edmins1}{\nofpages12}{\nofwords4716}{\nofchars26882}{\*\company  }{\nofcharsws33012}{\vern71}}\paperw11906\paperh16838 \deftab708\widowctrl\ftnbj\aenddoc\hyphhotz425\lytprtmet\hyphcaps0\formshade\viewkind1\viewscale89\pgbrdrhead\pgbrdrfoot \fet0\sectd \linex0\headery709\footery709\colsx709\endnhere\sectdefaultcl {\*\pnseclvl1\pnucrm\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl2\pnucltr\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl3\pndec\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl4\pnlcltr\pnstart1\pnindent720\pnhang{\pntxta )}}{\*\pnseclvl5\pndec\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl6\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl7\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl8\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl9\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}\pard\plain \s15\qr\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 Романов П.
\par }\pard\plain \s16\sb240\sa60\keepn\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\f1\fs28\lang1049\kerning28\cgrid {\f24\fs24 СОЦИАЛЬНО-ПРОФЕССИОНАЛЬНЫЕ ГРУППЫ НА РЫНКЕ ТРУДА
\par }\pard\plain \s15\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\i Предварительные соображения, предполагающие последующий количественный анализ данных
\par }\pard\plain \s20\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {\b Индикаторы для характеристики социально профессиональной структуры
\par }{Профессиональная принадлежность являются одним из наиболее значимых качеств работника, определяющим его место на рынке труда и в структуре современного общества. В условиях организационно стратифицированного общества представители определенных профессиональных групп демонстрируют сходные модели социального поведения. Речь идет о политических пристрастиях, определенных культурных стилях, потребительских предпочтениях, а также жизненных шансах и возможностях формирующихся в конкретных социально экономических обстоятельствах. Веберовский социально-стратификационный анализ рассматривает социальную концепцию профессии в терминах рынка. Профессия здесь \endash  особого рода деятельность, имеющая рыночную стоимость, которой занимаются с целью получения устойчивого дохода. Марксистская социология делает акцент на политико-экономические  связи, определяющие профессиональную структуру общества, а также распределение власти в ней. 
\par }\pard\plain \s15\qj\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 Пытаясь раскрыть социальную динамику тех процессов, которыми характеризуется современный российский рынок труда, мы бы хотели найти ответы на такие вопросы \endash  чем характеризуется структура рабочей силы новых и старых предприятий? какие категории наемных работников получают  преимущества, а кто оказывается в проигравших? какие категории работников в большей степени востребованы на рынке труда (как на новых, так и на старых предприятиях)? изменила ли свой характер профессиональная мобильность работников, интенсивность переходов между предприятиями и всем состоят социальные последствия таких изменений, если таковые есть?
\par …
\par 1. Факторы, влияющие на вероятность попадания индивида в ту или иную профессиональную группу. 
\par 
\par }\pard\plain \s21\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Рассматривая состав профессиональных групп, отличающихся различиями по характеру труда, типом карьеры, статусом (как мы полагаем, речь идет о властных полномочиях) О.Шкаратан полагает, что одним из определяющих факторов здесь является }{\b возраст}{ (В.В.Радаев, О.И.Шкаратан Социальная стратификация. М.: Аспект-Пресс, 1996. Сс. 99-100).  Речь идет о том, что данные о возрастной сегментации рабочей силы могут характеризовать различные профессии, а также профессиональную сегментацию. В соответствии с этим подходом особенностью профессиональной структуры является то, что она является как бы проекцией социальной структуры на процессы труда, поскольку определяет связи между людьми, устанавливающиеся в ходе этих процессов. Профессиональная структура здесь может рассматриваться в качестве иерархической системы, состоящей из ранжированных социальных позиций работников. В связи с этим выделяются 5 профессиональных возрастных групп:
\par {\pntext\pard\plain\s15 \f3\lang1049\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard\plain \s15\qj\fi-360\li360\nowidctlpar\widctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls2\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls2\adjustright \f16\fs20\lang1049\cgrid {\fs24 преобладают молодые работники (к этой группе относятся позиции вводного уровня карьеры и профессии, сформированные в связи с появлением новых технологий);
\par {\pntext\pard\plain\s15 \f3\lang1049\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s15\qj\fi-360\li360\nowidctlpar\widctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls2\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls2\adjustright {\fs24 преобладают работники среднего возраста (сюда относятся позиции, связанные с руководством);
\par {\pntext\pard\plain\s15 \f3\lang1049\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s15\qj\fi-360\li360\nowidctlpar\widctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls2\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls2\adjustright {\fs24 преобладают работники старшего возраста (здесь сосредоточены занятия, дающие возможность свободного распоряжения временем, исключающие большую нагрузку);
\par {\pntext\pard\plain\s15 \f3\lang1049\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s15\qj\fi-360\li360\nowidctlpar\widctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls2\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls2\adjustright {\fs24 однородное возрастное распределение маломобильной группы (лица свободной профессии и ремесленники);
\par {\pntext\pard\plain\s15 \f3\lang1049\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s15\qj\fi-360\li360\nowidctlpar\widctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls2\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}\ls2\adjustright {\fs24 возрастное распределение, состоящее из малоперспективных занятий, не требующих от работника заинтересованности (оно заполнено людьми разного возраста). 
\par }\pard \s15\qj\nowidctlpar\widctlpar\adjustright {\fs24 Настоящая типология открывая интересный перспективу с точки зрения эмпирических индикаторов, характеризует, скорее, стабильное состояние общества, где должностной рост является определяющим признаком успеха.  Кроме того, здесь не идет речь об }{\b\fs24 уровне дохода}{\fs24 , который, в настоящее время является весомой альтернативой карьерному продвижению. 
\par В.Мансуровым, который связал социальный состав и поведенческие характеристики работников с }{\b\fs24 типом предприятия}{\fs24 . Рассматривая предприятия оборонного комплекса, он отмечает, что  \ldblquote особенности функционирования предприятий ВПК (закрытость, опека со стороны государства, социальные и экономические привилегии) свели к минимуму вариативность поведения работников оборонного комплекса, снизили гибкость реагирования на меняющиеся обстоятельства в социальной среде\rdblquote . (Мансуров В.А. ИТР конверсируемых предприятий: проблемы социальной адаптации / Социально-трудовая сфера: динамика, качество человеческого потенциала, проблемы управления. Самара: СОГКС. Сс. 53-54). Кроме того, в этой работе рассматривается другой фактор, который, по мысли автора оказывает влияние на состав работников оборонных предприятий. Такой фактор можно было бы назвать }{\b\fs24 маргинальностью поселенческого статуса}{\fs24 , поскольку он разделяет работников ИТР из числа  на тех, кто является горожанином в первом поколении и теми, кто гаражанин во втором или третьем поколении. \ldblquote Новые\rdblquote  горожане, по мысли В.Мансурова \ldblquote держаться за рабочее место до последнего, несмотря на мизерную заработную плату, задержки с ее выплатой и т.п. ... однако, люди боятся потерять вследствие ухода с завода тот минимальный стандарт - статусный материальный, профессиональный - который они имеют, демонстрируя при этом боязнь перемен, психологическую неготовность изменить, организовать по новому свою жизнь, что возможно является следствием маргинального положения как горожан в первом поколении. Если этот тип адаптации можно назвать пассивным, то инженеры горожане (во втором, в третьем поколении) демонстрируют активную адаптацию. Не ожидая, как правило, увольнения/сокращения, они уходят с завода сами\rdblquote  (там же, с. 55). 
\par }\pard \s15\qj\fi708\nowidctlpar\widctlpar\adjustright {\fs24 Мы полагаем, что в этой и в ряде других используется понятие}{\b\fs24  }{\fs24 адаптивности на рынке труда, которое, как представляется можно продуктивно применить к характеристике социально профессиональных групп. Точного определения этого понятия нет, но, как становится ясно из аналитической логики, эмпирическим критерием адаптивности выступает }{\b\fs24 мобильность}{\fs24 , способность гибко менять рабочие места и профессии. В таком случае под определение попадают и те, кто нигде долго не держится благодаря своим низким профессиональным или психологическим качествам и кочует по рабочим местам с самыми неблагоприятными условиями работы.  Точнее, если исходить из этой логики, можно было бы определить совокупность дезадаптивных работников \endash  это те, кто остается на предприятии, несмотря на задержки заработной платы или низкий ее уровень (возможно, сюда можно было бы добавить плохие условия труда или что-либо другое, вызывающее неудовлетворенность работника своим рабочим местом). Однако в таком случае мы выпускаем из виду вторичную занятость, ставшую для многих единственным способом выживания. Многие люди в периоды вынужденных простоев предприятий перемещаются в сектор новых предприятий, где находят свой заработок, чаще всего на неквалифицированных рабочих местах, что подтверждается и в наших кейс стади рабочей силы. Социальный портрет работников, не покидающих приватизированных предприятий характеризуется, с точки зрения некоторых авторов, профессиональной гибкость, но совершенно особого рода. Работники на таких предприятиях, характеризуются готовностью \ldblquote к различным видам вторичной занятости, в том числе к "неорганизованной" коммерции\rdblquote . Различные категории рабочих, инженеров и служащих характеризует широкая активность в этом направлении. При этом сохраняется устойчивая ориентация на сохранение формальной занятости на предприятии. Мы считаем, что этот тип поведения на рынке труда вполне можно выделить как определенную модель адаптации к новым экономическим условиям. Более того, }{\b\fs24 вторичная занятость}{\fs24  становится одним из индикаторов, характеризующих социально-профессиональную структуру. При этом, однако, предполагается, что адаптация работников, предпочитающих вторичную занятость смене работы и профессии, имеет второсортный характер, что, на наш взгляд, необоснованно. 
\par }\pard\plain \s20\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Одним из традиционных индикаторов в исследованиях рабочей силы стало использование такого индикатора, как образование. В советском обществе, по мнению ряда исследователей (Руткевич М., Филлипов Ф.Р. (1970), Шкаратан О., Руковишников В.О. (1974), Ильин В. (1997)) существовали достаточно хорошо отлаженные каналы вертикальной мобильности. Важным средством карьерного роста стало образование. Например, в работе О.Шкаратана и В.Руковишникова, опирающейся на результаты международного сравнительного показано, что в СССР в семидесятых годах была выявлена очень тесная связь между социально профессиональным статусом и образованием респондента. Коэффициент связи достигал .57 (Япония \endash  .40, Австрия - .43). Исследования профессиональной мобильности последних лет показывают усиление процессов нисходящей мобильности. В условиях вынужденной мобильности, сокращения рабочей силы, происходит, как правило, снижение профессионального статуса (В.Гимпельсона, В.Магуна Уволенные на рынке труда: новая работа и социальная мобильность Социологический журнал, 1994, №1). Движение вниз становится платой за восстановление постоянной занятости \ldblquote экономика СССР и других стран социалистического блока была перенасыщена трудом невысокой квалификации... Пока потоки высвобожденных, естественно, направляются туда, где больше вакансий - а их больше для обладателей рабочих профессий\rdblquote  (с. 136-149). В первую очередь это относится к предприятиям государственного сектора: именно здесь сосредоточено преобладающее число подобных мест, а промышленный спад в России сопровождается, как отмечает Г.Стендинг, сохраняющимся спросом на физический труд (Стендинг Г. Изменение профессиональной структуры занятости в промышленности / Изменение структуры занятости и политика труда в Российской промышленности\rdblquote . М., 1992). В этих условиях наиболее неустойчивым является положение женщин на рынке труда. Они, как отмечают В.Гимпельсон и В.Магун, в большей степени, чем мужчины теряют в заработке и ухудшают условия своего труда при вынужденной мобильности. Действительно, пол является значимой переменной при характеристике рабочей силы и представляется обоснованной гипотеза о том, что текущие тенденции на рынке труда ведут к трансформациям гендерной структуры тех или иных профессий. Говоря об тенденциях переходного периода, попытаемся рассмотреть их влияние на основные социально-профессиональные группы. 
\par 
\par 
\par }\pard\plain \s17\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\f16\lang1049\cgrid {Динамика социально профессиональной структуры старых предприятий
\par Директорат
\par }\pard\plain \s20\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Категория управленцев в советском обществе относилась к числу наиболее привилегированных групп населения, однако никогда ранее социальная дифференциация не достигала таких масштабов, как в период экономических реформ. Как справедливо отмечается многими исследователями, ход приватизации обеспечил директорат предприятий широкими возможностями для повышения не только своего символического статуса, но и в отношение материальных выгод (Т.Заславская (1994)), С.Кларк (1997), А.Бим (1995)). Признается, что в существующих условиях многие руководители стремятся более к личному обогащению, чем направляют свои усилия на вывод предприятий из сложной экономической ситуации, связанной с конверсией, кризисом неплатежей и недостатком оборотных средств. При этом складывается мнение, что рост материального положения и властных позиций сопровождает не только высший, но и средний уровень менеджмента (П.Романов (1994), А.Бим (1995)). По мнению А.Бима \ldblquote типично вовлечение в состав руководства как относительно обособленного держателя акций всего влиятельного административно-управленческого персонала предприятий. Тем самым создается внутренне солидарная, объединенная имущественными интересами группа работников (служащих) предприятия, которая и до приватизации не составляла однородной массы с остальными работниками (иной уровень образования, сравнительно высокое должностное положение и др.) а ныне объединена также спецификой и возможностями приватизационного процесса\rdblquote  (Бим А.С.Социальные аспекты приватизации Куда идет Россия, М.: 1995с.127-129). 
\par \tab Особую роль наличие высокого статуса играет в процессе вынужденной и добровольной мобильности. Как обнаружили В.Гимпельсон и В.Магун, трудоустройство с сохранением или улучшением профессии, условий работы и доходов в большей степени характеризуют высокостатусные группы. Для этого есть объективные причины \endash  с повышением статуса работы, на которую претендует тот или иной работник, увеличивается значимость неформальных связей, необходимых, чтобы эту работу получить. 
\par }\pard\plain \s15\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 
\par }\pard\plain \s17\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\f16\lang1049\cgrid {ИТР И ВЫСОКО-КВАЛИФИЦИРОВАННЫЕ РАБОЧИЕ, ПРОФЕССИОНАЛЫ
\par }\pard\plain \s20\qj\fi708\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Рассматривая группу инженерно-технического персонала большинство авторов сходятся во мнении относительно общего снижения социального статуса, уровня доходов и престижа этих профессий (Л.Гордон (1994), Л.Семенова (1997), В.Мансуров (1998)).  Общее падение уровня промышленного производства и резкое сокращение оборонного заказа создали те экономические условия, в которых данные категории работников утратили практически все привелегии и преимущества, которыми обладали в советский период. Это обстоятельство даже позволило Л.Гордону выделить особую категорию бедности \endash  \ldblquote бедности сильных\rdblquote , отличающейся от бедности слабых, обусловленной социально-демографическими факторами (Гордон Л.А. Четыре рода бедности в современной России // Социологический журнал. 1994, №4). Работники с высокой квалификацией, работающие на предприятиях оборонного комплекса, а так же на приватизированных промышленных предприятиях, не способны в существующих условиях обеспечить достаточный уровень благосостояния для себя и своих близких. Как уже упоминалось, существуют и социально-культурные ограничения, сдерживающие адаптационные возможности этих категорий работников. Для ИТР \endash  горожан в первом поколении \ldblquote заметна межпоколенная трансляция низкого уровня экспектаций, поэтому адаптация к увольнениям и в период перед увольнениями протекает по другому, нежели у \ldblquote горожан\rdblquote  (В.Мансуров, 1998). 
\par 
\par }\pard\plain \s17\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\f16\lang1049\cgrid {Низкостатусные группы
\par }\pard\plain \s20\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Труд низкой квалификации сохраняет свою распространенность на российском рынке труда. Более того, по данным В.Гимпельсона и В.Магуна происходит увеличение этой группы или, если быть точнее интенсивное пополнение за счет более высокостатусных групп (В.Гимпельсон, В.Магун, 1994). Что интересно, на момент проведения исследования, до 73% процентов перемещений происходили в пределах государственного сектора экономики. Таким образом, можно говорить о деквалификации индустриального труда на российских промышленных предприятиях. В современной России эти категории работников вытесняются за пределы освоенных в предыдущие годы профессиональных ниш в процессе сокращений численности персонала. Есть свидетельства в пользу того, что переход в более низкую социально-профессиональную категорию почти автоматически означает снижение уровня жизни, поскольку удельный вес полу- и неквалифицированных рабочих среди тех, кого по уровню доходов можно отнести к бедным (от 0.25 до 0.5 среднедушевого дохода по выборке) выше чем в среднем по выборке (Л.А.Хахулина и М.Тучек Распределение доходов: бедные и богатые в постсоциалистических обществах // Куда идет Россия? 1995.)
\par Сравнительные исследования, направленные на изучение трудовой мотивации российских трудящихся делают акцент на доминировании \ldblquote пассивно-гедонистических ценностей\rdblquote  по отношению к работе у российских работников. \ldblquote Ценность интересной работы занимает в российской иерархии второе место, а активно достижительные ценности оказались на 12 месте…Ценности, связанные с возможностью не работать ("большой отпуск"), избегать неудобств (удобное время") или излишнего давления на работе (не давят") имеют в России более высокие ранги, нежели в совокупном массиве остальных стран (Магун В.С.Трудовые ценности российского населения: социалистическая модель и постсоциалистические реальности // Куда идет Россия?, М.: 1997). Представляет интерес тот факт, что эти ценности воспроизводятся от поколения к поколению, как показывают результаты более раннего исследования, проведенного под руководством В.А.Ядова в 1976 г.. Они показывают, что по крайней мере у индустриальных рабочих, лидировала ценность высокого заработка, а ценности активной самореализации и повышения квалификации занимали последнее место по частоте выбора.
\par }\pard \s20\qj\fi708\nowidctlpar\widctlpar\adjustright {Таким образом, можно говорить о двух подходах к истолкованию нисходящей профессиональной мобильности. Одна из них утверждает приоритет социально культурных установок работника, значимость сформированного в условиях Советского общества устойчивого комплекса ценностей, ограничивающих адаптивные способности российского работника. Другие первопричиной считают определенный экономический контекст, благодаря которому падают шансы на рынке труда определенных категорий работников, имевших выгодные позиции в условиях плановой экономики СССР.
\par }\pard\plain \s15\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 
\par }\pard\plain \s23\nowidctlpar\widctlpar\adjustright \b\f16\lang1049\cgrid {Формирование социально \endash профессиональной структуры новых предприятий
\par }\pard\plain \s15\qj\fi284\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 Социально-экономические перемены в условиях России коренным образом изменили социальный смысл связи между профессиональной образованием и рынком труда. Государственные институты специального образования - ПТУ, техникумы и высшие учебные заведения и новые образовательные организации, в том числе те, которые предлагают пройти обучение по специальностям, воспринимаемым в массовом сознании как престижные, выгодные (например, биржевых брокеров, риэлтеров, бухгалтеров, менеджеров широкого профиля) более не гарантируют трудоустройство своим выпускникам. Стало обыденным явлением то, что эти люди самостоятельно трудоустраиваются и подчас не по тем специальностям, по которым они проходили свое обучение. Десять лет назад человек, который занимается профессиональной деятельностью в сфере, где он не получил образование, вызвал бы недоверие. Специальное образование, как правило, определяло весь трудовой путь работника, и его перемещения на рынке труда осуществлялись по определенным институциализированным каналам, таким, как отделы кадров, службы занятости, в которых образовательные сертификаты играли ключевую роль. На первом этапе работник получал образование, специальность и сертификат (диплом, свидетельство об окончании чего-либо, \ldblquote корочки\rdblquote ) о необходимой специальной подготовке. В ограниченных, в силу известных причин, условиях советского рынка труда лишь такой сертификат открывал возможность профессионализации - предъявление его при поступлении на работу позволяло занимать определенные должности, участвовать в определенной деятельности. На втором этапе человек становился профессионалом - входил в профессиональное сообщество, знакомился с его культурными нормами и неформальными требованиями, стандартами, накапливал опыт работы, повышал квалификацию, статус и, как следствие - материальное положение.
\par В условиях либерализации экономики произошло крушение традиционной статусной иерархии профессий. Деньги обрели реальную покупательную силу, стали определять положение человека в обществе. Обнаружилось, что не обязательно быть }{\i\fs24 специалистом}{\fs24 -профессионалом, чтобы зарабатывать большие деньги. Более важен - }{\i\fs24 профессионализм в зарабатывании денег, }{\fs24 т.е. обладание нужными связями, умение договориться с людьми, быть мобильным и легко перестраиваться. Одним из направлений создания малого бизнеса стал уход специалистов из государственных предприятий с тем, чтобы создать собственное дело. Такой отток был особенно интенсивен в первые годы легализации частного бизнеса - в эпоху кооперативов, он усилился в связи с углублением экономического кризиса в начале 1990-х, продолжается он и теперь, хоть и в меньших масштабах. Почему специалисты покидают государственную службу или работу на крупных предприятиях, почему они, получив дипломы, работают не по специальности? Причин тут несколько - неспособность крупных бюрократизированных организаций предоставить отдельным творческим личностям пространство для самореализации; в государственных структурах вознаграждение не всегда соответствует уровню притязаний высококвалифицированных специалистов; инициативы специалистов не встречают отклика у администрации; положение  специалистов-профессионалов в больших организациях не  возвышается соответствующим образом - статусно и материально.
\par Сегодня ситуация быстро меняется и вектор изменений определяется работой на новых предприятиях, созданных после 1990 года. Заметим, что именно здесь создание новых профессий идет особенно интенсивно. Уже никого не удивляет, если продавец в магазине бытовой техники закончил технический университет, владелец автомастерской - бывший преподаватель истории, а коммивояжер, торгующий косметикой - учительница начальных классов. В 1991-1994 годах особенно оживленно и встревожено обсуждались проблемы девальвации ценностей специального образования. Приходилось слышать \ldblquote молодежь не хочет учиться, аудитории ВУЗов пустеют, все бросились зарабатывать деньги\rdblquote . Действительно, рыночная экономика привела к возникновению множества новых профессий, по которым никогда не готовили или готовили не по тем направлениям, которые стали актуальны в новых условиях. На новых предприятиях подчас можно встретить отрицательное отношение к \ldblquote старым\rdblquote  профессионалам. В интервью с представителями предприятий торговли, где мы проводили исследование, к типичным можно  отнести такое рассуждение: \ldblquote }{\i\fs24 Вы знаете, мы стараемся не брать продавцов из государственной торговли. Они \ldblquote испорчены\rdblquote  теми нравами, которые там царят, небрежны, грубы, зачастую нечисты на руку}{\fs24 \rdblquote . Менеджер по кадрам фирмы, торгующей бытовой техникой, описывает свои критерии найма: \ldblquote }{\i\fs24 для работы со сложной бытовой техникой мы подыскиваем, как правило, молодого выпускника какого-нибудь технического ВУЗа. Такой человек, как правило, вежлив, может поговорить с покупателем и описать характеристики продукции, дать свои рекомендации, поможет разобраться в инструкции}{\fs24 \rdblquote . Его коллега из другой фирмы поддерживает эту позицию: \ldblquote }{\i\fs24 нам нужны люди со свежим мышлением, с незамыленным взглядом, не обломавшиеся в государственных структурах}{\fs24 \rdblquote .
\par {\*\bkmkstart зак}{\*\bkmkend зак}Осуществляя исследование \ldblquote новых\rdblquote  малых предприятий, и мы изучили механизмы найма, профессиональной мобильности, кадровой политики на десятках фирм такого рода. Какие образцы социально-профессиональных изменений демонстрируются здесь? Почему? 
\par }\pard\plain \s17\fi284\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\f16\lang1049\cgrid {Бизнес требует от специалистов повышать профессионализм
\par }\pard\plain \s15\qj\fi284\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 Тон здесь задают предприятия, занимающиеся классическими типами профессиональной деятельности - юристы, врачи, экономисты. Основатели дела здесь, как правило, предприниматели, которые ушли с государственной службы, из больших организаций, чтобы начать бизнес именно в той сфере, в которой такие люди получили образования и достигли определенного уровня компетентности. Как правило это действительно хорошие специалисты, они талантливы и достаточно продолжительное время накапливали необходимые профессиональные навыки которые стали частью статуса. Фактор сохранения профессионального статуса, укрепление его имеет особую социальную ценность. Самое главное свойство профессий, которыми обладают эти предприниматели - конкурентоспособность. Знания могут быть легко обращены в деньги на сегодняшнем рынке труда. Для многих юристов и экономистов специальность по прежнему соответствует профессионализму и накопление опыта, образование связей также, как и прежде может принести немалую выгоду обладателю этих специальностей.   
\par Рассмотрим более подробно судьбу дантиста Т. (Кемерово). Владелец индивидуального частного предприятия создал свое дело в 1991 г. Основные направления работы фирмы - торговля стоматологическим оборудованием и оказание платной стоматологической помощи. Т. прервал свою карьеру вузовского ученого, когда осознал, что \ldblquote }{\i\fs24 кроме дипломов и благодарностей нечего оставить своему сыну. Никаких материальных благ накопить, оставаясь на кафедре, не удастся}{\fs24 \rdblquote . В интервью, которые дает владелец фирмы в ходе нашего исследования, присутствует образ профессионализма как социального стандарта: \ldblquote ...}{\i\fs24 в десятом классе я точно знал, что хочу быть главврачом стоматологической поликлиники. На моё решение сильное влияние оказал отец моей одноклассницы - главный врач городской стоматологии. Замечательный человек и }{\i\fs24\ul специалист}{\i\fs24 . Я и по сей день вспоминаю его с особой теплотой и благодарностью\rdblquote . }{\fs24 Здесь также обнаруживают себя и ориентации на карьеру, на социальный статус, которые в не меньшей степени определяют стремление к успеху и достижению. Работники фирмы отдают должное и постоянному стремлению Т. к развитию, к освоению нового, его неисчерпаемому запасу идей }{\i\fs24 \ldblquote это человек с каким-то просто дьявольским нюхом на всё новое\rdblquote ,}{\fs24  а характеризуя}{\i\fs24  }{\fs24 его поразительную работоспособность и энергичность употребляют такие слова, как \ldblquote трудоголик\rdblquote  и \ldblquote двигатель.  
\par Фирма Т. начала свою деятельность с создания курсов повышения квалификации для врачей стоматологов, а затем перешла к продаже современного медицинского оборудования. В чем заключается логика рассуждений Т., обосновывающего такой поворот в бизнесе? Здесь мы опять встречаем образ \ldblquote специалиста\rdblquote , который является базовым в аргументациях Т. }{\i\fs24 \ldblquote Это было совершенно естественно, ибо без соответствующего оборудования и расходных материалов было бы невозможным делом реализовать полученные знания на практике\rdblquote  . }{\fs24 А объясняя принципы своей работы предприниматель делает акцент на обучении, как факторе конкурентоспособности фирмы на местном рынке услуг. Западные стандарты для него являются нормирующим показателем и поэтому образ западной технологии в рассуждениях нашего собеседника также занимает важное место. }{\i\fs24 \ldblquote В принципе есть два варианта. Первый - самим разрабатывать новые знания и технологии, второй - перенимать их у других. Мы придерживаемся второго. Мы берём лучшее, что есть в мире по данному направлению, и овладеваем им безукоризненно. Я могу с уверенностью сказать, что медицинская помощь, которая оказывается в нашей фирме, находится на уровне европейских, мировых стандартов\rdblquote  .}{\fs24 
\par Заметим здесь, что прибыль, которая поступает с продаж медицинского  оборудования - наиболее рентабельной сферы деятельности предприятия, которым владеет Т., в инвестируется, среди прочего, в обучение персонала, в том числе и за границей. Изучение кадровой политики фирмы показывает, что основными принципами при найме является не только привлечение квалифицированных кадров (точнее говоря работников, способных стать высококвалифицированными специалистами), но и их стремление к овладению новыми знаниями, повышению профессиональной квалификации, готовность и способность постоянно учиться и переучиваться. Пожалуй, именно наличие перечисленных выше качеств определяет в первую очередь положение работника в фирме, возможности его должностного роста, будет ли он принят на работу, останется ли он, в конечном итоге, работать здесь или будет вынужден уйти. Постоянное повышение квалификации фактически вменено в обязанности врача, работающего в фирме Т.. В должностной инструкции врача-стоматолога, которая была разработана самим Т., записано, что \ldblquote }{\i\fs24 врач обязан пройти все курсы, проводимые учебным центром фирмы... Врач обязан иметь подписку на все профессиональные журналы}{\fs24 \rdblquote . Причем, как заметила одна из врачей, }{\i\fs24 \ldblquote Т. может подойти к тебе и спросить: \ldblquote А что Вы думаете по поводу того-то (т.е., что недавно было опубликовано в нашем специальном журнале)?\rdblquote 
\par }\pard\plain \s20\qj\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Таким образом, из этого и других имеющихся у нас в распоряжении свидетельств, можно предположить что в этом секторе рынка новых предприятий профессионализм укрепляется. Конкуренция здесь очень высока и существуют устойчивые механизмы социального контроля - например такие, как профессиональные ассоциации, которые регулируют поведение и отношение к деятельности-ремеслу.
\par }\pard\plain \s17\fi284\keepn\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\f16\lang1049\cgrid {Найти сотрудника не сложно
\par }\pard\plain \s15\qj\fi284\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 К настоящему времени рынок труда насыщен специалистами самого различного профиля и на многих \ldblquote новых\rdblquote  предприятиях администрация выработала особое отношение к отбору сотрудников. Главным требованием, как и в случае с \ldblquote Кормами\rdblquote , является наличие высшего образование и возраст - достаточно молодой, чтобы быть человек сохранил динамизм, восприимчивость и готовность сменить профиль деятельности. Высшее образование здесь, судя по высказываниям многих из наших собеседников, ответственных за кадровые вопросы, является скорее символом определенного интеллектуального потенциала, чем свидетельством экспертности в какой-либо сфере.
\par На работу в рекламное агентство (Самара) приглашают через объявления в газетах, устанавливая единственное требование для кандидатов - наличие высшего образования. Работа в такой организации выдвигает особые требования - для тех, кто составляет рекламные тексты, необходимы некоторые литературные способности, от рекламных агентов ожидается психологическая гибкость, контактный стиль общения. Эти критерии легко распознать с помощью несложной проверки, при непосредственном общении. Наиболее существенно то, что для большинства рабочих мест в фирме не требуется специализированная подготовка, те качества личности, о которых говорилось выше, могут быть натренированы, а могут быть особенностью характера или воспитания. Как показывают беседы с сотрудниками агентства, администрация выражает убеждение, что повышение квалификации является личным делом каждого и не поддерживает инициативы, требующие какой-либо институциализации в этой области. 
\par При таком подходе к человеческому потенциалу профессионал не востребован. Текучесть достаточно высока, но уровень сервиса, который обеспечивает предприятие на рынке услуг, не предъявляет таких высоких стандартов, которые нельзя было бы обеспечить установившейся политикой найма, требованиями к сотрудникам. Небольшое число рабочих мест требует специальных знаний - компьютерные верстальщики, создатели рекламы, бухгалтер - однако администрация фирмы полагает, что найти таких специалистов на рынке труда можно, поэтому не затрачивает усилий на их сохранение и специализацию.  
\par }\pard\plain \s20\qj\fi284\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Относительно новой профессией является деятельность по так называемому \ldblquote сетевому маркетингу\rdblquote  (герболайф, косметика, страхование) - работа, где реализация какого-либо товара совмещена с рекрутированием новых сотрудников-распространителей. Фирмы, занятые таким бизнесом относятся сегодня к числу наиболее успешных в мире, у них отсутствует традиционный фиксированный найм, специфические взаимоотношения между работником и работодателем. Что представляется наиболее значимым с точки зрения предпринятого нами исследования - основным идеологическим принципом здесь является такой \ldblquote работать у нас может каждый, попробуйте и станете богачом\rdblquote .
\par }\pard\plain \s15\qj\fi284\nowidctlpar\widctlpar\adjustright \f16\fs20\lang1049\cgrid {\fs24 Некоторые практики найма становятся общими для всех новых предприятий. К таким можно отнести использование испытательного срока для рабочих мест, созданных под новые профессии, куда принимают сотрудников, не имеющих специального образования. Испытательный срок - важный инструмент в отборе персонала. Работник в течение какого-либо ограниченного периода времени должен пройти \ldblquote обряд посвящения\rdblquote  - продемонстрировать свою способность научиться \ldblquote технической\rdblquote  (операциональной) стороне дела, принять этику ремесла и проявить готовность сотрудничать с администрацией фирмы. После такой процедуры открывается возможность стать профессионалом - получить специальное образование или опыт работы. Депрофессионализация - вот что определяет положение дел на многих на малых предприятиях. Здесь нужна дешевая и более послушная рабочая сила, а профессионалы нормированы своим этосом, являются дорогой рабочей силой. Работники на этом секторе рынка труда меняют один вид деятельности на другой и масштабы этих процессов в настоящее время значительны.
\par Успешные фирмы выдвигают жесткие критерии профессионализма и постоянно поддерживают его через систему обучения и дообучения. Здесь тон задают фирмы осуществляющие классические типы профессиональной деятельности, с устоявшимся этосом, принципами социального контроля и профессиональнми ассоциациями. Крупные фирмы могут себе позволить комплектовать из них свои штаты. Обучение на фирме редкость и администрация предпочитает брать готовых, сформировавшихся работников. Впрочем, успешные фирмы с новыми видами деятельности, особенно в тех сферах, где устанавливается лицензирование профессиональной деятельности, культивируют профессионалов либо через систему рекрутирования новых сотрудников, выдвигая высокие стандарты, где образование и опыт играют определяющую роль, либо с помощью корпоративного обучения. Обучение на фирмах, корпоративное обучение призвано интегрировать сотрудников в фирменную культуру, структуру ее ценностей, норм.
\par }\pard\plain \s20\qj\fi284\nowidctlpar\widctlpar\adjustright \f16\lang1049\cgrid {Тип профессионалов как особого социального слоя находится в России в стадии формирования, ситуация на рынке труда новых видов деятельности весьма противоречива. Институты образования определенного типа, соответствующие государственные законы, профессиональные объединения и гильдии лишь складываются в настоящее время. Вполне вероятно, что многочисленные небольшие предприятия и в дальнейшем окажутся той губкой, которая будет впитывать в себя рабочую силу, которая либо только вступает на рынок труда, либо, в результате экономических реформ, утратила прежний профессиональный статус своей профессии и уровень жизни. 
\par }}